<% content_for :title, "Items – TIBIALY" %>

<!-- Hero -->
<section class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-4 mb-4">
  <div class="card p-6 sm:p-8" data-rise style="--d:0">
    <p class="label mb-3 flex items-center gap-2"><span class="live"></span> Item prices · updated from TibiaWiki</p>
    <h1 class="serif text-[34px] sm:text-[44px] leading-[1.05] max-w-2xl">
      What is your loot <span class="text-amber-400">really</span> worth?
    </h1>
    <p class="text-stone-400 text-[15px] mt-3 max-w-xl">Best NPC buyer and Market value for every tradeable item. Pick your world for live Market prices.</p>

    <form method="get" action="/" class="mt-6 flex flex-col sm:flex-row gap-2">
      <div class="relative flex-1">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-500" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="text" id="search-q" name="q" value="<%= @query %>" autocomplete="off"
               placeholder="Search an item… e.g. Dragon Scale Mail" class="field pl-10 h-[44px]">
      </div>
      <select name="sort" onchange="this.form.submit()" class="field h-[44px] sm:w-44">
        <option value="market" <%= "selected" if @sort == "market" %>>Market value</option>
        <option value="value"  <%= "selected" if @sort == "value"  %>>NPC price</option>
        <option value="name"   <%= "selected" if @sort == "name"   %>>Name A–Z</option>
      </select>
      <select id="world-sel" class="field h-[44px] sm:w-40"><option value="">World</option><option value="Antica">Antica</option><option value="Bona">Bona</option><option value="Calmera">Calmera</option><option value="Celesta">Celesta</option><option value="Chrona">Chrona</option><option value="Damora">Damora</option><option value="Descubra">Descubra</option><option value="Dibra">Dibra</option><option value="Duna">Duna</option><option value="Eldera">Eldera</option><option value="Epoca">Epoca</option><option value="Fera">Fera</option><option value="Firmera">Firmera</option><option value="Gladera">Gladera</option><option value="Harmonia">Harmonia</option><option value="Helera">Helera</option><option value="Honbra">Honbra</option><option value="Igobra">Igobra</option><option value="Inabra">Inabra</option><option value="Javibra">Javibra</option><option value="Kalibra">Kalibra</option><option value="Kenora">Kenora</option><option value="Laudera">Laudera</option><option value="Lobera">Lobera</option><option value="Luminera">Luminera</option><option value="Lutabra">Lutabra</option><option value="Mabera">Mabera</option><option value="Marcia">Marcia</option><option value="Menera">Menera</option><option value="Mercera">Mercera</option><option value="Mitigera">Mitigera</option><option value="Monza">Monza</option><option value="Morta">Morta</option><option value="Mundra">Mundra</option><option value="Mythera">Mythera</option><option value="Nadora">Nadora</option><option value="Nefera">Nefera</option><option value="Nobra">Nobra</option><option value="Nossobra">Nossobra</option><option value="Odera">Odera</option><option value="Ombra">Ombra</option><option value="Optionis">Optionis</option><option value="Pacembra">Pacembra</option><option value="Peloria">Peloria</option><option value="Premia">Premia</option><option value="Pythera">Pythera</option><option value="Quelibra">Quelibra</option><option value="Refugia">Refugia</option><option value="Relania">Relania</option><option value="Ribera">Ribera</option><option value="Runera">Runera</option><option value="Sabura">Sabura</option><option value="Secura">Secura</option><option value="Serdebra">Serdebra</option><option value="Silvera">Silvera</option><option value="Solidera">Solidera</option><option value="Talera">Talera</option><option value="Thyria">Thyria</option><option value="Torpera">Torpera</option><option value="Trimera">Trimera</option><option value="Umbra">Umbra</option><option value="Unebra">Unebra</option><option value="Utobra">Utobra</option><option value="Venebra">Venebra</option><option value="Victoris">Victoris</option><option value="Vunira">Vunira</option><option value="Wadalbra">Wadalbra</option><option value="Wintera">Wintera</option><option value="Wizera">Wizera</option><option value="Xandebra">Xandebra</option><option value="Yonabra">Yonabra</option><option value="Zanera">Zanera</option><option value="Zunera">Zunera</option></select>
      <button type="submit" class="btn-primary h-[44px] px-5">Search</button>
    </form>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="card p-5 flex flex-col justify-between" data-rise style="--d:1">
      <p class="label">Items tracked</p>
      <p class="serif text-[40px] leading-none num mt-4" data-count="<%= Item.where.not(market_item_id: nil).count %>">0</p>
      <p class="text-xs text-stone-500 mt-2">with a Market id</p>
    </div>
    <div class="card p-5 flex flex-col justify-between" data-rise style="--d:2">
      <p class="label">NPC buyers</p>
      <p class="serif text-[40px] leading-none num mt-4" data-count="<%= NpcPrice.buy.count %>">0</p>
      <p class="text-xs text-stone-500 mt-2">buy offers known</p>
    </div>
    <a href="/loot" class="card card-hover p-5 col-span-2 flex items-center justify-between gap-4 group" data-rise style="--d:3">
      <div>
        <p class="label">After a hunt</p>
        <p class="text-[15px] mt-1">Paste your Hunt Analyser and see where to sell each item</p>
      </div>
      <span class="text-stone-500 group-hover:text-white group-hover:translate-x-1 transition-all text-xl">→</span>
    </a>
  </div>
</section>

<div id="price-loading-status" class="hidden text-center py-2 text-[13px] text-stone-400">
  <span id="price-loading-text">Loading prices…</span>
</div>

<div id="items-results">
<section class="card overflow-hidden" data-rise style="--d:4">
  <div class="flex items-center justify-between px-5 pt-4 pb-3">
    <h2 class="text-[15px] font-medium">
      <% if @query.present? %>
        <%= @total_count %> result<%= @total_count == 1 ? "" : "s" %> for “<%= @query %>”
      <% else %>
        All items
      <% end %>
    </h2>
    <span class="label num">Page <%= @page %> of <%= @total_pages %></span>
  </div>

<% if @items.empty? %>
  <div class="text-center py-20 divider">
    <p class="serif text-2xl">No items found.</p>
    <% if @query.present? %>
      <p class="text-sm text-stone-500 mt-2">Try a different search term.</p>
    <% else %>
      <p class="text-sm text-stone-500 mt-2">Run <code class="kbd">rake tibia:import</code> to import data.</p>
    <% end %>
  </div>
<% else %>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th class="w-12">#</th>
          <th>Item</th>
          <th class="text-right hidden sm:table-cell">NPC price</th>
          <th class="text-right">Market</th>
          <th class="text-center hidden md:table-cell">vs NPC</th>
          <th class="hidden lg:table-cell">Best buyer</th>
        </tr>
      </thead>
      <tbody class="stagger">
        <% offset = (@page - 1) * ItemsController::PER_PAGE %>
        <% @items.each_with_index do |item, i| %>
          <tr class="cursor-pointer" onclick="window.location='<%= item_path(item.slug) %>'" data-market-id="<%= item.market_item_id.to_i %>">
            <td class="text-xs text-stone-500 num"><%= offset + i + 1 %></td>
            <td>
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-stone-900 border border-white/5 grid place-items-center shrink-0">
                  <% if item.image_url.present? %>
                    <img src="<%= item.image_url %>" alt="" class="w-8 h-8 object-contain sprite" loading="lazy" onerror="this.style.display='none'">
                  <% end %>
                </div>
                <div class="min-w-0">
                  <a href="<%= item_path(item.slug) %>" class="font-medium hover:text-amber-300 transition-colors"><%= item.name %></a>
                  <div class="flex items-center gap-2 mt-0.5">
                    <% if item.item_type.present? %><span class="tag"><%= item.item_type %></span><% end %>
                    <% if item.weight.present? %><span class="text-xs text-stone-500 num"><%= item.weight %> oz</span><% end %>
                  </div>
                </div>
              </div>
            </td>
            <td class="text-right hidden sm:table-cell num">
              <% if item.highest_npc_buy_price.to_i > 0 %>
                <span class="font-medium text-amber-400"><%= number_with_delimiter(item.highest_npc_buy_price) %></span><span class="text-xs text-stone-500"> gp</span>
              <% else %>
                <span class="text-stone-600">—</span>
              <% end %>
            </td>
            <td class="text-right num" data-live-price data-db-price="<%= item.avg_market_price.to_i %>">
              <% if item.avg_market_price.to_i > 0 %>
                <span class="font-medium text-sky-400"><%= number_with_delimiter(item.avg_market_price) %></span><span class="text-xs text-stone-500"> gp</span>
              <% else %>
                <span class="text-stone-600">—</span>
              <% end %>
            </td>
            <td class="text-center hidden md:table-cell">
              <% pct = item.market_premium_pct %>
              <% if pct && pct > 0 %>
                <span class="verdict market num">+<%= pct %>%</span>
              <% elsif item.avg_market_price.to_i > 0 && item.highest_npc_buy_price.to_i > 0 %>
                <span class="verdict equal">≈ NPC</span>
              <% else %>
                <span class="text-stone-600">—</span>
              <% end %>
            </td>
            <td class="hidden lg:table-cell text-stone-300"><%= item.best_buyer&.npc_name || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
</section>

<% if @items.any? && @total_pages > 1 %>
  <%
    q_part    = @query.present? ? "&q=#{CGI.escape(@query)}" : ""
    sort_part = "&sort=#{@sort}"
    pages_to_show = ([@page - 2, 1].max..[@page + 2, @total_pages].min).to_a
    pages_to_show = [1] + pages_to_show if pages_to_show.first > 1
    pages_to_show = pages_to_show + [@total_pages] if pages_to_show.last < @total_pages
    pages_to_show.uniq!
  %>
  <nav class="mt-5 flex items-center justify-center gap-3 flex-wrap">
    <% if @page > 1 %>
      <a href="?page=<%= @page - 1 %><%= q_part %><%= sort_part %>" class="btn btn-ghost">← Prev</a>
    <% end %>
    <div class="seg">
      <% prev_p = nil %>
      <% pages_to_show.each do |p| %>
        <% if prev_p && p - prev_p > 1 %><span class="px-1.5 self-center text-stone-600">…</span><% end %>
        <% if p == @page %>
          <button type="button" aria-pressed="true" class="num"><%= p %></button>
        <% else %>
          <a href="?page=<%= p %><%= q_part %><%= sort_part %>" class="num h-[30px] px-3 rounded-[9px] text-[12.5px] font-medium text-stone-500 hover:text-white inline-flex items-center transition-colors"><%= p %></a>
        <% end %>
        <% prev_p = p %>
      <% end %>
    </div>
    <% if @page < @total_pages %>
      <a href="?page=<%= @page + 1 %><%= q_part %><%= sort_part %>" class="btn btn-ghost">Next →</a>
    <% end %>
  </nav>
  <p class="text-center text-xs text-stone-500 mt-3 num">
    Showing <%= (@page - 1) * ItemsController::PER_PAGE + 1 %>–<%= [@page * ItemsController::PER_PAGE, @total_count].min %> of <%= @total_count %>
  </p>
<% end %>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/fuse.js/6.6.2/fuse.min.js"></script>

<script>
// ── TIBIALY globals ──────────────────────────────────────────────────
window.TLF = (function(){
  var activeFetchId = 0; // incremented on every fetchLivePrices call; stale responses check this

  function restoreDbPrices(){
    activeFetchId++; // cancel any in-flight fetch
    TLFUI.sweep(false);
    document.getElementById('price-loading-status').classList.add('hidden');
    document.querySelectorAll('[data-live-price]').forEach(function(cell){
      var db = parseInt(cell.getAttribute('data-db-price'), 10);
      cell.innerHTML = db > 0
        ? '<span class="font-medium text-sky-400">' + db.toLocaleString() + '</span><span class="text-xs text-stone-500"> gp</span>'
        : '<span class="text-stone-600">—</span>';
    });
  }

  function fetchLivePrices(world){
    var fetchId = ++activeFetchId; // unique ID for this call; any previous calls are now stale

    var rows = Array.from(document.querySelectorAll('tr[data-market-id]'));
    var ids  = rows.map(function(r){ return r.getAttribute('data-market-id'); })
                   .filter(function(id){ return id && parseInt(id,10) > 0; });
    if (!ids.length) return;

    var statusEl  = document.getElementById('price-loading-status');
    var statusTxt = document.getElementById('price-loading-text');
    TLFUI.sweep(true);
    if (statusEl)  statusEl.classList.remove('hidden');
    if (statusTxt) statusTxt.textContent  = 'Loading live ' + world + ' prices…';

    // Set all market-avg cells to spinner
    rows.forEach(function(row){
      var cell = row.querySelector('[data-live-price]');
      if (cell) cell.innerHTML = '<span class="skeleton inline-block w-16 h-4 align-middle">&nbsp;</span>';
    });

    // Single batch call through our Rails proxy (avoids CORS)
    var url = '/items/market_prices?world=' + encodeURIComponent(world) + '&item_ids=' + ids.join(',');

    fetch(url)
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (fetchId !== activeFetchId) return; // stale — a newer fetch already took over
        // Build id→price map; prefer buy_offer (current highest offer), fall back to month_average_buy
        var priceMap = {};
        (Array.isArray(data) ? data : Object.values(data)).forEach(function(m){
          if (!m || !m.id) return;
          var p = (m.buy_offer > 0) ? m.buy_offer
                : (m.month_average_buy > 0) ? m.month_average_buy : 0;
          if (p > 0) priceMap[String(m.id)] = p;
        });

        rows.forEach(function(row){
          var mid  = row.getAttribute('data-market-id');
          var cell = row.querySelector('[data-live-price]');
          if (!cell) return;
          var price = priceMap[mid];
          cell.innerHTML = price
            ? '<span class="font-medium text-sky-300">' + Number(price).toLocaleString() + '</span><span class="text-xs text-stone-500"> gp</span> <span class="live" title="Live price"></span>'
            : '<span class="text-stone-600">—</span>';
        });
      })
      .catch(function(){
        if (fetchId !== activeFetchId) return;
        rows.forEach(function(row){
          var cell = row.querySelector('[data-live-price]');
          if (cell) cell.innerHTML = '<span class="text-stone-600">?</span>';
        });
      })
      .finally(function(){
        if (fetchId === activeFetchId) {
          TLFUI.sweep(false);
          if (statusEl) statusEl.classList.add('hidden');
        }
      });
  }

  return { fetchLivePrices: fetchLivePrices, restoreDbPrices: restoreDbPrices,
           currentWorld: localStorage.getItem('tibia_world') || '' };
})();
</script>

<script>
// ── Fuse.js fuzzy search ─────────────────────────────────────────────────────
(function(){
  var inp = document.getElementById("search-q");
  if (!inp) return;
  if (new URLSearchParams(location.search).get("focus")) inp.focus();

  var allNames = null;
  var fuse     = null;
  var timer;

  fetch("/items/names")
    .then(function(r){ return r.json(); })
    .then(function(names){
      allNames = names;
      fuse = new Fuse(names, {
        includeScore: true,
        threshold: 0.42,
        distance: 120,
        minMatchCharLength: 2
      });
    });

  function fetchResults(url) {
    history.replaceState(null, "", url);
    fetch(url, {headers: {"X-Requested-With": "XMLHttpRequest"}})
      .then(function(r){ return r.text(); })
      .then(function(html){
        var doc   = new DOMParser().parseFromString(html, "text/html");
        var fresh = doc.getElementById("items-results");
        if (fresh) {
          document.getElementById("items-results").innerHTML = fresh.innerHTML;
          document.querySelectorAll("#items-results .stagger > tr").forEach(function(tr, i){ tr.style.setProperty("--i", i); });
          // Re-apply live prices if a world is active
          if (window.TLF && window.TLF.currentWorld) {
            window.TLF.fetchLivePrices(window.TLF.currentWorld);
          }
        }
      });
  }

  function fuzzySearch(q) {
    if (!fuse) return null;
    var words = q.trim().split(/\s+/).filter(function(w){ return w.length >= 2; });
    if (!words.length) return [];
    var sets = words.map(function(word){
      var results = fuse.search(word);
      var s = {};
      results.forEach(function(r){ s[r.item] = true; });
      return s;
    });
    var threshold = Math.ceil(words.length * 0.55);
    return allNames.filter(function(name){
      var hits = sets.reduce(function(count, s){ return count + (s[name] ? 1 : 0); }, 0);
      return hits >= threshold;
    });
  }

  inp.addEventListener("input", function(){
    clearTimeout(timer);
    timer = setTimeout(function(){
      var q    = inp.value.trim();
      var sort = document.querySelector("select[name=sort]").value;

      if (!q) {
        fetchResults("/?sort=" + encodeURIComponent(sort));
        return;
      }

      var matched = fuzzySearch(q);
      if (matched === null) {
        fetchResults("/?q=" + encodeURIComponent(q) + "&sort=" + encodeURIComponent(sort));
        return;
      }

      if (!matched.length) {
        fetchResults("/?fuzzy[]=__none__&sort=" + encodeURIComponent(sort));
        return;
      }

      var params = matched.map(function(n){ return "fuzzy[]=" + encodeURIComponent(n); }).join("&");
      fetchResults("/?" + params + "&sort=" + encodeURIComponent(sort));
    }, 280);
  });
})();
</script>

<script>
// ── World selector ────────────────────────────────────────────────────────────
(function(){
  var ws = document.getElementById('world-sel');
  if (!ws) return;

  var saved = window.TLF ? window.TLF.currentWorld : (localStorage.getItem('tibia_world') || '');
  ws.value = saved;

  // Auto-fetch on every page load (including pagination) if a world is stored
  if (saved && window.TLF) {
    window.TLF.fetchLivePrices(saved);
  }

  ws.addEventListener('change', function(){
    var w = this.value;
    if (w) localStorage.setItem('tibia_world', w);
    else   localStorage.removeItem('tibia_world');
    if (window.TLF) window.TLF.currentWorld = w;

    TLFUI.showWorld();

    // Fetch happens on Search (page reload); world selection just saves the preference.
  });
})();
</script>
