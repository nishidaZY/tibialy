<div class="mb-5">
  <a href="/" class="text-sm font-medium transition-colors hover:underline"
     style="color:var(--accent)">← Back to items</a>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

  <!-- Item card -->
  <div class="md:col-span-1">
    <div class="card-bg rounded-xl p-6 text-center">
      <% if @item.image_url.present? %>
        <img src="<%= @item.image_url %>" alt="<%= @item.name %>"
          class="w-20 h-20 object-contain mx-auto mb-4" style="image-rendering:pixelated"
          onerror="this.style.display='none'">
      <% else %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8" width="64" height="64" style="image-rendering:pixelated;shape-rendering:crispEdges;display:block;margin:auto"><style>@keyframes prsh{0%{transform:translateY(0)scaleY(1)scaleX(1)}30%{transform:translateY(-5px)scaleY(1.08)scaleX(0.93)}60%{transform:translateY(0)scaleY(0.68)scaleX(1.18)}78%{transform:translateY(-2px)scaleY(1.04)scaleX(0.98)}100%{transform:translateY(0)scaleY(1)scaleX(1)}}.prsh{animation:prsh 0.65s ease-in-out infinite;transform-box:fill-box;transform-origin:bottom center}</style><g class="prsh"><rect x="2" y="0" width="1" height="1" fill="#FF79C6"/><rect x="3" y="0" width="1" height="1" fill="#FF79C6"/><rect x="4" y="0" width="1" height="1" fill="#FF79C6"/><rect x="5" y="0" width="1" height="1" fill="#FF79C6"/><rect x="1" y="1" width="1" height="1" fill="#FF79C6"/><rect x="2" y="1" width="1" height="1" fill="#FF79C6"/><rect x="3" y="1" width="1" height="1" fill="#FF79C6"/><rect x="4" y="1" width="1" height="1" fill="#FF79C6"/><rect x="5" y="1" width="1" height="1" fill="#FF79C6"/><rect x="6" y="1" width="1" height="1" fill="#FF79C6"/><rect x="0" y="2" width="1" height="1" fill="#FF79C6"/><rect x="1" y="2" width="1" height="1" fill="#FF79C6"/><rect x="2" y="2" width="1" height="1" fill="#FF79C6"/><rect x="3" y="2" width="1" height="1" fill="#FF79C6"/><rect x="4" y="2" width="1" height="1" fill="#FF79C6"/><rect x="5" y="2" width="1" height="1" fill="#FF79C6"/><rect x="6" y="2" width="1" height="1" fill="#FF79C6"/><rect x="7" y="2" width="1" height="1" fill="#FF79C6"/><rect x="0" y="3" width="1" height="1" fill="#FF79C6"/><rect x="1" y="3" width="1" height="1" fill="#FF79C6"/><rect x="3" y="3" width="1" height="1" fill="#FF79C6"/><rect x="4" y="3" width="1" height="1" fill="#FF79C6"/><rect x="6" y="3" width="1" height="1" fill="#FF79C6"/><rect x="7" y="3" width="1" height="1" fill="#FF79C6"/><rect x="0" y="4" width="1" height="1" fill="#FF79C6"/><rect x="1" y="4" width="1" height="1" fill="#FF79C6"/><rect x="3" y="4" width="1" height="1" fill="#FF79C6"/><rect x="4" y="4" width="1" height="1" fill="#FF79C6"/><rect x="6" y="4" width="1" height="1" fill="#FF79C6"/><rect x="7" y="4" width="1" height="1" fill="#FF79C6"/><rect x="0" y="5" width="1" height="1" fill="#FF79C6"/><rect x="1" y="5" width="1" height="1" fill="#FF79C6"/><rect x="2" y="5" width="1" height="1" fill="#FF79C6"/><rect x="5" y="5" width="1" height="1" fill="#FF79C6"/><rect x="6" y="5" width="1" height="1" fill="#FF79C6"/><rect x="7" y="5" width="1" height="1" fill="#FF79C6"/><rect x="1" y="6" width="1" height="1" fill="#FF79C6"/><rect x="2" y="6" width="1" height="1" fill="#FF79C6"/><rect x="3" y="6" width="1" height="1" fill="#FF79C6"/><rect x="4" y="6" width="1" height="1" fill="#FF79C6"/><rect x="5" y="6" width="1" height="1" fill="#FF79C6"/><rect x="6" y="6" width="1" height="1" fill="#FF79C6"/><rect x="2" y="7" width="1" height="1" fill="#FF79C6"/><rect x="3" y="7" width="1" height="1" fill="#FF79C6"/><rect x="4" y="7" width="1" height="1" fill="#FF79C6"/><rect x="5" y="7" width="1" height="1" fill="#FF79C6"/><rect x="3" y="1" width="1" height="1" fill="#FFB8E0"/><rect x="4" y="1" width="1" height="1" fill="#FFB8E0"/><rect x="2" y="3" width="1" height="1" fill="#191A21"/><rect x="5" y="3" width="1" height="1" fill="#191A21"/><rect x="2" y="4" width="1" height="1" fill="#191A21"/><rect x="5" y="4" width="1" height="1" fill="#191A21"/><rect x="3" y="5" width="1" height="1" fill="#191A21"/><rect x="4" y="5" width="1" height="1" fill="#191A21"/></g></svg>
      <% end %>

      <h1 class="text-xl font-bold mb-1" style="color:var(--dark)"><%= @item.name %></h1>
      <% if @item.item_type.present? %>
        <span class="tag"><%= @item.item_type %></span>
      <% end %>

      <div class="text-left text-sm space-y-2 mt-4 pt-4" style="border-top:1px solid var(--border)">
        <% if @item.weight.present? %>
          <div class="flex justify-between">
            <span style="color:var(--muted)">Weight</span>
            <span style="color:var(--dark)"><%= @item.weight %> oz</span>
          </div>
        <% end %>
        <div class="flex justify-between">
          <span style="color:var(--muted)">Best NPC</span>
          <span class="font-bold tibia-gold">
            <%= @item.highest_npc_buy_price.to_i > 0 ? "#{number_with_delimiter(@item.highest_npc_buy_price)} gp" : "—" %>
          </span>
        </div>
      </div>

      <a href="<%= @item.wiki_url %>" target="_blank"
        class="mt-6 block text-center text-xs hover:underline"
        style="color:var(--accent)">
        View on TibiaWiki ↗
      </a>
    </div>
  </div>

  <!-- Prices -->
  <div class="md:col-span-2 space-y-5">

    <!-- NPC Buyers -->
    <div class="card-bg rounded-xl overflow-hidden">
      <div class="px-5 py-3" style="border-bottom:1px solid var(--border)">
        <h2 class="font-semibold text-sm uppercase tracking-wide tibia-gold">🪙 NPCs that buy</h2>
        <p class="text-xs mt-0.5" style="color:var(--muted)">What NPCs pay you for this item</p>
      </div>
      <% if @buy_prices.any? %>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs uppercase" style="background:var(--sand); color:var(--muted)">
              <th class="px-5 py-2 text-left">NPC</th>
              <th class="px-5 py-2 text-left">Location</th>
              <th class="px-5 py-2 text-right">Price</th>
            </tr>
          </thead>
          <tbody>
            <% @buy_prices.each_with_index do |price, i| %>
              <tr style="border-bottom:1px solid var(--border); <%= i == 0 ? 'background:#3D3F50;' : 'background:var(--cream);' %>">
                <td class="px-5 py-3 font-medium" style="color:var(--dark)">
                  <%= i == 0 ? "⭐ " : "" %><a href="https://www.tibiawiki.com.br/wiki/<%= URI.encode_www_form_component(price.npc_name.gsub(' ', '_')) %>" target="_blank" class="hover:underline" style="color:var(--accent)"><%= price.npc_name %></a>
                </td>
                <td class="px-5 py-3 text-xs" style="color:var(--muted)"><%= price.npc_location || "—" %></td>
                <td class="px-5 py-3 text-right font-bold <%= i == 0 ? 'tibia-gold' : '' %>"
                    style="<%= i > 0 ? 'color:var(--muted)' : '' %>">
                  <%= number_with_delimiter(price.price) %> gp
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-5 py-6 text-sm" style="color:var(--muted)">No NPC buys this item.</p>
      <% end %>
    </div>

    <!-- NPC Sellers -->
    <% if @sell_prices.any? %>
      <div class="card-bg rounded-xl overflow-hidden">
        <div class="px-5 py-3" style="border-bottom:1px solid var(--border)">
          <h2 class="font-semibold text-sm uppercase tracking-wide" style="color:var(--brown)">🏪 NPCs that sell</h2>
          <p class="text-xs mt-0.5" style="color:var(--muted)">Where to buy this item from NPCs</p>
        </div>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs uppercase" style="background:var(--sand); color:var(--muted)">
              <th class="px-5 py-2 text-left">NPC</th>
              <th class="px-5 py-2 text-left">Location</th>
              <th class="px-5 py-2 text-right">Price</th>
            </tr>
          </thead>
          <tbody>
            <% @sell_prices.each do |price| %>
              <tr style="border-bottom:1px solid var(--border); background:var(--cream)">
                <td class="px-5 py-3"><a href="https://www.tibiawiki.com.br/wiki/<%= URI.encode_www_form_component(price.npc_name.gsub(' ', '_')) %>" target="_blank" class="hover:underline" style="color:var(--accent)"><%= price.npc_name %></a></td>
                <td class="px-5 py-3 text-xs" style="color:var(--muted)"><%= price.npc_location || "—" %></td>
                <td class="px-5 py-3 text-right" style="color:var(--brown)">
                  <%= number_with_delimiter(price.price) %> gp
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

  </div>
</div>
