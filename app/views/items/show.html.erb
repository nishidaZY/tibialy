<% content_for :title, "#{@item.name} – TibiaLootFinder" %>

<a href="/" class="inline-flex items-center gap-1.5 text-[13px] text-stone-400 hover:text-white transition-colors mb-4" data-rise>← All items</a>

<div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-4" data-market-id="<%= @item.market_item_id.to_i %>">

  <!-- Item -->
  <aside class="card p-6 self-start" data-rise style="--d:1">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="label mb-2"><%= @item.item_type.presence || "Item" %></p>
        <h1 class="serif text-[32px] leading-[1.05]"><%= @item.name %></h1>
      </div>
      <div class="w-20 h-20 rounded-2xl bg-stone-900 border border-white/5 grid place-items-center shrink-0">
        <% if @item.image_url.present? %>
          <img src="<%= @item.image_url %>" alt="<%= @item.name %>" class="w-16 h-16 object-contain sprite" onerror="this.style.display='none'">
        <% end %>
      </div>
    </div>

    <% best = @buy_prices.first %>
    <div class="mt-6">
      <p class="label">Best NPC price</p>
      <p class="serif text-[44px] leading-none mt-2 num">
        <% if @item.highest_npc_buy_price.to_i > 0 %>
          <span class="text-amber-400" data-count="<%= @item.highest_npc_buy_price.to_i %>">0</span><span class="text-lg text-stone-500 font-sans"> gp</span>
        <% else %>
          <span class="text-stone-600">—</span>
        <% end %>
      </p>
      <% if best %><p class="text-[13px] text-stone-400 mt-2"><%= best.npc_name %><%= " · #{best.npc_location}" if best.npc_location.present? %></p><% end %>
    </div>

    <dl class="mt-6 divider pt-4 space-y-2.5 text-[13.5px]">
      <% if @item.weight.present? %>
        <div class="flex justify-between"><dt class="text-stone-500">Weight</dt><dd class="num"><%= @item.weight %> oz</dd></div>
      <% end %>
      <% if @item.avg_market_price.to_i > 0 %>
        <div class="flex justify-between"><dt class="text-stone-500">Market average</dt><dd class="num text-sky-400"><%= number_with_delimiter(@item.avg_market_price) %> gp</dd></div>
      <% end %>
      <div class="flex justify-between"><dt class="text-stone-500">NPCs buying</dt><dd class="num"><%= @buy_prices.size %></dd></div>
    </dl>

    <a href="<%= @item.wiki_url %>" target="_blank" rel="noopener" class="btn btn-ghost w-full mt-6">View on TibiaWiki ↗</a>
  </aside>

  <div class="flex flex-col gap-4 min-w-0">

    <!-- Live market (world-specific) -->
    <section id="live-price-card" class="card overflow-hidden" style="display:none" data-rise>
      <div class="px-5 pt-4 pb-3 flex items-center justify-between">
        <h2 class="text-[15px] font-medium flex items-center gap-2"><span class="live"></span> Market on <span id="live-world-name"></span></h2>
        <span class="label">Live · TibiaData</span>
      </div>
      <div id="live-price-body" class="px-5 pb-5 text-sm">
        <div class="grid grid-cols-2 gap-6"><span class="skeleton h-10">&nbsp;</span><span class="skeleton h-10">&nbsp;</span></div>
      </div>
    </section>

    <!-- NPC buyers -->
    <section class="card overflow-hidden" data-rise style="--d:2">
      <div class="px-5 pt-4 pb-3 flex items-baseline justify-between gap-4">
        <h2 class="text-[15px] font-medium">NPCs that buy</h2>
        <span class="label">What NPCs pay you for this item</span>
      </div>
      <% if @buy_prices.any? %>
        <% top = @buy_prices.first.price.to_f %>
        <table class="table">
          <thead><tr><th>NPC</th><th class="hidden sm:table-cell">Location</th><th class="text-right">Price</th></tr></thead>
          <tbody class="stagger">
            <% @buy_prices.each_with_index do |price, i| %>
              <tr>
                <td>
                  <a href="https://www.tibiawiki.com.br/wiki/<%= URI.encode_www_form_component(price.npc_name.gsub(' ', '_')) %>" target="_blank" rel="noopener" class="font-medium hover:text-amber-300 transition-colors"><%= price.npc_name %></a>
                  <% if i == 0 %><span class="verdict npc ml-2">Best</span><% end %>
                  <div class="bar mt-2 max-w-[220px]"><i style="width:<%= top > 0 ? (price.price / top * 100).round : 0 %>%; background:<%= i == 0 ? 'var(--gold)' : 'var(--line-2)' %>"></i></div>
                </td>
                <td class="hidden sm:table-cell text-stone-400 text-[13px]"><%= price.npc_location || "—" %></td>
                <td class="text-right num font-medium <%= i == 0 ? 'text-amber-400' : 'text-stone-400' %>"><%= number_with_delimiter(price.price) %> gp</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-5 pb-6 text-sm text-stone-500">No NPC buys this item.</p>
      <% end %>
    </section>

    <!-- NPC sellers -->
    <% if @sell_prices.any? %>
      <section class="card overflow-hidden" data-rise style="--d:3">
        <div class="px-5 pt-4 pb-3 flex items-baseline justify-between gap-4">
          <h2 class="text-[15px] font-medium">NPCs that sell</h2>
          <span class="label">Where to buy it from NPCs</span>
        </div>
        <table class="table">
          <thead><tr><th>NPC</th><th class="hidden sm:table-cell">Location</th><th class="text-right">Price</th></tr></thead>
          <tbody class="stagger">
            <% @sell_prices.each do |price| %>
              <tr>
                <td><a href="https://www.tibiawiki.com.br/wiki/<%= URI.encode_www_form_component(price.npc_name.gsub(' ', '_')) %>" target="_blank" rel="noopener" class="font-medium hover:text-amber-300 transition-colors"><%= price.npc_name %></a></td>
                <td class="hidden sm:table-cell text-stone-400 text-[13px]"><%= price.npc_location || "—" %></td>
                <td class="text-right num text-stone-300"><%= number_with_delimiter(price.price) %> gp</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>
  </div>
</div>

<script>
(function(){
  var world = localStorage.getItem('tibia_world');
  var grid  = document.querySelector('[data-market-id]');
  var marketId = grid ? parseInt(grid.getAttribute('data-market-id'), 10) : 0;
  if (!world || !marketId) return;

  var card      = document.getElementById('live-price-card');
  var worldSpan = document.getElementById('live-world-name');
  var body      = document.getElementById('live-price-body');

  worldSpan.textContent = world;
  card.style.display = '';

  fetch('https://api.tibiadata.com/v4/market/' + encodeURIComponent(world) + '/item/' + marketId)
    .then(function(r){ return r.json(); })
    .then(function(data){
      var item = data.market && data.market.item;
      if (!item) { body.innerHTML = '<p class="text-stone-500">No market data for this world.</p>'; return; }

      var buy  = item.buy_statistics  || item.buyed  || {};
      var sell = item.sell_statistics || item.sold   || {};
      var fmt  = function(n){ return (n && n > 0) ? Number(n).toLocaleString() + ' gp' : '—'; };
      var traders = function(n){ return (n && n > 0) ? n + ' transaction' + (n === 1 ? '' : 's') : 'no trades'; };

      body.innerHTML =
        '<div class="grid grid-cols-2 gap-6">' +
          '<div>' +
            '<p class="label mb-2">Buyers paying</p>' +
            '<p class="serif text-[34px] leading-none num text-amber-400">' + fmt(buy.last_day_value || buy.average) + '</p>' +
            '<p class="text-xs text-stone-500 mt-2">' + traders(buy.last_day_traders || buy.total) + ' today</p>' +
          '</div>' +
          '<div>' +
            '<p class="label mb-2">Sellers asking</p>' +
            '<p class="serif text-[34px] leading-none num text-sky-400">' + fmt(sell.last_day_value || sell.average) + '</p>' +
            '<p class="text-xs text-stone-500 mt-2">' + traders(sell.last_day_traders || sell.total) + ' today</p>' +
          '</div>' +
        '</div>' +
        '<p class="text-xs text-stone-500 mt-5 pt-3 divider">' +
          'Last 24 hours · <a class="text-stone-300 hover:text-white" href="https://www.tibia.com/market/?currenttab=buy&itemid=' + marketId + '&world=' + encodeURIComponent(world) + '" target="_blank" rel="noopener">View on Tibia.com ↗</a>' +
        '</p>';
    })
    .catch(function(){
      body.innerHTML = '<p class="text-stone-500">Could not load live data.</p>';
    });
})();
</script>
