D93F9"/><rect x="4" y="7" width="1" height="1" fill="#BD93F9"/><rect x="5" y="7" width="1" height="1" fill="#BD93F9"/><rect x="6" y="7" width="1" height="1" fill="#BD93F9"/><rect x="7" y="7" width="1" height="1" fill="#BD93F9"/><rect x="8" y="7" width="1" height="1" fill="#BD93F9"/><rect x="9" y="7" width="1" height="1" fill="#BD93F9"/><rect x="10" y="7" width="1" height="1" fill="#BD93F9"/><rect x="1" y="8" width="1" height="1" fill="#BD93F9"/><rect x="2" y="8" width="1" height="1" fill="#BD93F9"/><rect x="3" y="8" width="1" height="1" fill="#BD93F9"/><rect x="8" y="8" width="1" height="1" fill="#BD93F9"/><rect x="9" y="8" width="1" height="1" fill="#BD93F9"/><rect x="10" y="8" width="1" height="1" fill="#BD93F9"/><rect x="0" y="9" width="1" height="1" fill="#BD93F9"/><rect x="1" y="9" width="1" height="1" fill="#BD93F9"/><rect x="2" y="9" width="1" height="1" fill="#BD93F9"/><rect x="3" y="9" width="1" height="1" fill="#BD93F9"/><rect x="4" y="9" width="1" height="1" fill="#BD93F9"/><rect x="5" y="9" width="1" height="1" fill="#BD93F9"/><rect x="6" y="9" width="1" height="1" fill="#BD93F9"/><rect x="7" y="9" width="1" height="1" fill="#BD93F9"/><rect x="8" y="9" width="1" height="1" fill="#BD93F9"/><rect x="9" y="9" width="1" height="1" fill="#BD93F9"/><rect x="10" y="9" width="1" height="1" fill="#BD93F9"/><rect x="11" y="9" width="1" height="1" fill="#BD93F9"/><rect class="cw" x="3" y="5" width="1" height="1" fill="#F1FA8C"/><rect class="cw" x="5" y="5" width="1" height="1" fill="#F1FA8C"/><rect class="cw" x="6" y="5" width="1" height="1" fill="#F1FA8C"/><rect class="cw" x="8" y="5" width="1" height="1" fill="#F1FA8C"/><rect class="cw" x="3" y="6" width="1" height="1" fill="#F1FA8C"/><rect class="cw" x="5" y="6" width="1" height="1" fill="#F1FA8C"/><rect class="cw" x="6" y="6" width="1" height="1" fill="#F1FA8C"/><rect class="cw" x="8" y="6" width="1" height="1" fill="#F1FA8C"/></g></svg>
          <div>
            <span class="pixel text-sm leading-tight" style="color:#BD93F9">Tibia</span>
            <span class="pixel text-sm leading-tight text-white"> Loot</span>
            <p class="text-xs mt-1" style="color: rgba(189,147,249,0.4); font-family: system-ui">NPC Prices · TibiaWiki</p>
          </div>
        </a>
        <nav class="flex items-center gap-6 text-xs pixel" style="color:rgba(189,147,249,0.7)">
          <a href="/" class="hover:text-white transition-colors flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 7 9" width="14" height="18" style="image-rendering:pixelated;shape-rendering:crispEdges;display:inline;vertical-align:middle"><style>@keyframes sg{0%{fill:rgba(189,147,249,0.85)}12%{fill:#F8F8F2}24%{fill:rgba(189,147,249,0.85)}100%{fill:rgba(189,147,249,0.85)}}.sg0{animation:sg 1.4s 0.0s infinite}.sg1{animation:sg 1.4s 0.3s infinite}.sg2{animation:sg 1.4s 0.6s infinite}.sg3{animation:sg 1.4s 0.9s infinite}.sg4{animation:sg 1.4s 1.2s infinite}.sg5{animation:sg 1.4s 1.5s infinite}.sg6{animation:sg 1.4s 1.8s infinite}@keyframes sgsw{0%,100%{transform:rotate(-5deg)}50%{transform:rotate(5deg)}}.sgsw{animation:sgsw 2.4s ease-in-out infinite;transform-box:fill-box;transform-origin:bottom center}</style><g class="sgsw"><rect class="sg0" x="6" y="0" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect class="sg1" x="5" y="1" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect class="sg2" x="4" y="2" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect class="sg3" x="3" y="3" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect class="sg4" x="2" y="4" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect class="sg5" x="1" y="5" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect class="sg6" x="0" y="6" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect x="6" y="1" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect x="5" y="2" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect x="4" y="3" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect x="3" y="4" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect x="2" y="5" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect x="1" y="6" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect x="2" y="6" width="1" height="1" fill="rgba(189,147,249,0.85)"/><rect x="0" y="7" width="1" height="1" fill="rgba(189,147,249,0.85)"/></g></svg> Items</a>
          <a href="/loot" class="hover:text-white transition-colors flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8" width="22" height="22" style="image-rendering:pixelated;shape-rendering:crispEdges;display:inline;vertical-align:middle"><style>@keyframes prnv{0%{transform:translateY(0)scaleY(1)scaleX(1)}18%{transform:translateY(-7px)scaleY(1.1)scaleX(0.91)}42%{transform:translateY(-8px)scaleY(1.13)scaleX(0.9)}60%{transform:translateY(0)scaleY(0.65)scaleX(1.2)}73%{transform:translateY(-3px)scaleY(1.07)scaleX(0.95)}86%{transform:translateY(0)scaleY(0.94)scaleX(1.03)}100%{transform:translateY(0)scaleY(1)scaleX(1)}}.prnv{animation:prnv 0.85s ease-in-out infinite;transform-box:fill-box;transform-origin:bottom center}@keyframes prbl{0%,78%{fill:#191A21}82%,90%{fill:#FF79C6}94%,100%{fill:#191A21}}.preye{animation:prbl 3.2s ease-in-out infinite}</style><g class="prnv"><rect x="2" y="0" width="1" height="1" fill="#FF79C6"/><rect x="3" y="0" width="1" height="1" fill="#FF79C6"/><rect x="4" y="0" width="1" height="1" fill="#FF79C6"/><rect x="5" y="0" width="1" height="1" fill="#FF79C6"/><rect x="1" y="1" width="1" height="1" fill="#FF79C6"/><rect x="2" y="1" width="1" height="1" fill="#FF79C6"/><rect x="3" y="1" width="1" height="1" fill="#FF79C6"/><rect x="4" y="1" width="1" height="1" fill="#FF79C6"/><rect x="5" y="1" width="1" height="1" fill="#FF79C6"/><rect x="6" y="1" width="1" height="1" fill="#FF79C6"/><rect x="0" y="2" width="1" height="1" fill="#FF79C6"/><rect x="1" y="2" width="1" height="1" fill="#FF79C6"/><rect x="2" y="2" width="1" height="1" fill="#FF79C6"/><rect x="3" y="2" width="1" height="1" fill="#FF79C6"/><rect x="4" y="2" width="1" height="1" fill="#FF79C6"/><rect x="5" y="2" width="1" height="1" fill="#FF79C6"/><rect x="6" y="2" width="1" height="1" fill="#FF79C6"/><rect x="7" y="2" width="1" height="1" fill="#FF79C6"/><rect x="0" y="3" width="1" height="1" fill="#FF79C6"/><rect x="1" y="3" width="1" height="1" fill="#FF79C6"/><rect x="3" y="3" width="1" height="1" fill="#FF79C6"/><rect x="4" y="3" width="1" height="1" fill="#FF79C6"/><rect x="6" y="3" width="1" height="1" fill="#FF79C6"/><rect x="7" y="3" width="1" height="1" fill="#FF79C6"/><rect x="0" y="4" width="1" height="1" fill="#FF79C6"/><rect x="1" y="4" width="1" height="1" fill="#FF79C6"/><rect x="3" y="4" width="1" height="1" fill="#FF79C6"/><rect x="4" y="4" width="1" height="1" fill="#FF79C6"/><rect x="6" y="4" width="1" height="1" fill="#FF79C6"/><rect x="7" y="4" width="1" height="1" fill="#FF79C6"/><rect x="0" y="5" width="1" height="1" fill="#FF79C6"/><rect x="1" y="5" width="1" height="1" fill="#FF79C6"/><rect x="2" y="5" width="1" height="1" fill="#FF79C6"/><rect x="5" y="5" width="1" height="1" fill="#FF79C6"/><rect x="6" y="5" width="1" height="1" fill="#FF79C6"/><rect x="7" y="5" width="1" height="1" fill="#FF79C6"/><rect x="1" y="6" width="1" height="1" fill="#FF79C6"/><rect x="2" y="6" width="1" height="1" fill="#FF79C6"/><rect x="3" y="6" width="1" height="1" fill="#FF79C6"/><rect x="4" y="6" width="1" height="1" fill="#FF79C6"/><rect x="5" y="6" width="1" height="1" fill="#FF79C6"/><rect x="6" y="6" width="1" height="1" fill="#FF79C6"/><rect x="2" y="7" width="1" height="1" fill="#FF79C6"/><rect x="3" y="7" width="1" height="1" fill="#FF79C6"/><rect x="4" y="7" width="1" height="1" fill="#FF79C6"/><rect x="5" y="7" width="1" height="1" fill="#FF79C6"/><rect x="3" y="1" width="1" height="1" fill="#FFB8E0"/><rect x="4" y="1" width="1" height="1" fill="#FFB8E0"/><rect class="preye" x="2" y="3" width="1" height="1" fill="#191A21"/><rect class="preye" x="5" y="3" width="1" height="1" fill="#191A21"/><rect class="preye" x="2" y="4" width="1" height="1" fill="#191A21"/><rect class="preye" x="5" y="4" width="1" height="1" fill="#191A21"/><rect x="3" y="5" width="1" height="1" fill="#191A21"/><rect x="4" y="5" width="1" height="1" fill="#191A21"/></g></svg> Loot Analyzer</a>
        <span id="world-pill" style="display:none;background:rgba(189,147,249,0.12);border:1px solid rgba(189,147,249,0.3);color:var(--accent);font-size:9px;padding:3px 9px;border-radius:99px;font-family:system-ui;cursor:pointer;white-space:nowrap" title="Click to clear world" onclick="localStorage.removeItem('tibia_world');this.style.display='none'">🌍 <span id="world-pill-name"></span> ×</span><script>(function(){var w=localStorage.getItem('tibia_world');if(w){document.getElementById('world-pill-name').textContent=w;document.getElementById('world-pill').style.display='';}})();</script>
