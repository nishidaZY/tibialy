<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Tibia Loot Analyser</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
      /* ── Pixel font for headings ─────────────────────────── */
      .pixel { font-family: 'Press Start 2P', monospace; }

      /* ── Dracula palette ─────────────────────────────────── */
      :root {
        --sand:      #282A36;
        --cream:     #21222C;
        --tan:       #BD93F9;
        --brown:     #F8F8F2;
        --dark:      #F8F8F2;
        --text:      #F8F8F2;
        --muted:     #6272A4;
        --accent:    #BD93F9;
        --gold:      #FFB86C;
        --border:    #44475A;
        --header-bg: #191A21;
      }

      /* System font — same as macOS/iOS */
      body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
                     "SF Pro Display", system-ui, "Helvetica Neue", Arial, sans-serif;
        background: var(--sand);
        color: var(--text);
        min-height: 100vh;
      }

      .tibia-gold   { color: var(--gold); }
      .card-bg      { background: var(--cream); border: 1px solid var(--border); }
      .card-hover   { transition: transform 0.12s ease, box-shadow 0.12s ease; }
      .card-hover:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(0,0,0,0.45);
      }
      .btn-primary  {
        background: var(--accent);
        color: #fff;
        font-weight: 600;
        border-radius: 8px;
        transition: background 0.15s;
      }
      .btn-primary:hover { background: #a07de8; }
      .tag {
        display: inline-block;
        background: #44475A;
        color: #F8F8F2;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 99px;
        font-weight: 500;
      }
    </style>
  </head>

  <body>
    <!-- Header -->
