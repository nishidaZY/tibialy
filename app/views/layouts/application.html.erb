<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Tibia Loot Finder</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body { background-color: #0f0f0f; }
      .tibia-gold { color: #d4a843; }
      .tibia-bg { background: linear-gradient(135deg, #1a1008 0%, #0f0a04 100%); }
      .card-hover { transition: transform 0.15s ease, box-shadow 0.15s ease; }
      .card-hover:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(212,168,67,0.15); }
    </style>
  </head>
  <body class="text-gray-100 min-h-screen" style="background:#0f0f0f">
    <header class="border-b border-yellow-900/40" style="background:#1a0f04">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <span class="text-2xl">⚔️</span>
          <div>
            <span class="text-xl font-bold tibia-gold">Tibia</span>
            <span class="text-xl font-bold text-white"> Loot Finder</span>
            <p class="text-xs text-yellow-600/70">Preços NPC · TibiaWiki.com.br</p>
          </div>
        </a>
        <nav class="text-sm text-yellow-700">
          <a href="/" class="hover:text-yellow-400 transition-colors">Itens</a>
        </nav>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-yellow-900/30 mt-16 py-6 text-center text-xs text-yellow-900">
      Dados de <a href="https://www.tibiawiki.com.br" target="_blank" class="underline hover:text-yellow-700">TibiaWiki.com.br</a> ·
      Fan site não oficial · Tibia é marca registrada da CipSoft GmbH
    </footer>
  </body>
</html>
