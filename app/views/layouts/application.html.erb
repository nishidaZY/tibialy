<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Tibia Loot Finder</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      /* ── Desert palette ───────────────────────────────────── */
      :root {
        --sand:      #EDE0C4;
        --cream:     #FBF5E6;
        --tan:       #C9A96E;
        --brown:     #5C3A1E;
        --dark:      #2C1A08;
        --text:      #2C1A08;
        --muted:     #7A5C35;
        --accent:    #C4621D;
        --gold:      #A07808;
        --border:    #D4B896;
        --header-bg: #3B2410;
      }

      /* System font — same as macOS/iOS */
      body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
                     "SF Pro Display", system-ui, "Helvetica Neue", Arial, sans-serif;
        background: var(--sand);
        color: var(--text);
        min-height: 100vh;
      }

      .tibia-gold   { color: var(--gold); }
      .card-bg      { background: var(--cream); border: 1px solid var(--border); }
      .card-hover   { transition: transform 0.12s ease, box-shadow 0.12s ease; }
      .card-hover:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(92,58,30,0.12);
      }
      .btn-primary  {
        background: var(--accent);
        color: #fff;
        font-weight: 600;
        border-radius: 8px;
        transition: background 0.15s;
      }
      .btn-primary:hover { background: #a44f16; }
      .tag {
        display: inline-block;
        background: #EDD9B5;
        color: var(--brown);
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 99px;
        font-weight: 500;
      }
    </style>
  </head>

  <body>
    <!-- Header -->
    <header style="background: var(--header-bg); border-bottom: 1px solid rgba(212,184,150,0.2);">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 no-underline">
          <span class="text-2xl">⚔️</span>
          <div>
            <span class="text-xl font-bold" style="color:var(--tan)">Tibia</span>
            <span class="text-xl font-bold text-white"> Loot Finder</span>
            <p class="text-xs" style="color: rgba(201,169,110,0.55)">Preços NPC · TibiaWiki.com.br</p>
          </div>
        </a>
        <nav class="flex items-center gap-6 text-sm" style="color:rgba(201,169,110,0.7)">
          <a href="/" class="hover:text-white transition-colors">🗡️ Itens</a>
          <a href="/loot" class="hover:text-white transition-colors">🎒 Loot Analyzer</a>
        </nav>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <footer style="border-top: 1px solid var(--border); color: var(--muted);"
            class="mt-16 py-6 text-center text-xs">
      Dados de <a href="https://www.tibiawiki.com.br" target="_blank"
        style="color:var(--accent)" class="underline">TibiaWiki.com.br</a> ·
      Fan site não oficial · Tibia é marca registrada da CipSoft GmbH
    </footer>
  </body>
</html>
