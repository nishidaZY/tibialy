<% content_for :title, "Loot Analyzer – TibiaLootFinder" %>

<div class="max-w-5xl mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8 text-center">
    <h1 class="text-3xl font-bold tibia-gold mb-2 flex items-center justify-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8" width="40" height="40" style="image-rendering:pixelated;shape-rendering:crispEdges;display:inline;vertical-align:middle"><style>@keyframes prla{0%{transform:translateY(0)scaleY(1)scaleX(1)}30%{transform:translateY(-5px)scaleY(1.08)scaleX(0.93)}60%{transform:translateY(0)scaleY(0.68)scaleX(1.18)}78%{transform:translateY(-2px)scaleY(1.04)scaleX(0.98)}100%{transform:translateY(0)scaleY(1)scaleX(1)}}.prla{animation:prla 0.65s ease-in-out infinite;transform-box:fill-box;transform-origin:bottom center}</style><g class="prla"><rect x="2" y="0" width="1" height="1" fill="#FF79C6"/><rect x="3" y="0" width="1" height="1" fill="#FF79C6"/><rect x="4" y="0" width="1" height="1" fill="#FF79C6"/><rect x="5" y="0" width="1" height="1" fill="#FF79C6"/><rect x="1" y="1" width="1" height="1" fill="#FF79C6"/><rect x="2" y="1" width="1" height="1" fill="#FF79C6"/><rect x="3" y="1" width="1" height="1" fill="#FF79C6"/><rect x="4" y="1" width="1" height="1" fill="#FF79C6"/><rect x="5" y="1" width="1" height="1" fill="#FF79C6"/><rect x="6" y="1" width="1" height="1" fill="#FF79C6"/><rect x="0" y="2" width="1" height="1" fill="#FF79C6"/><rect x="1" y="2" width="1" height="1" fill="#FF79C6"/><rect x="2" y="2" width="1" height="1" fill="#FF79C6"/><rect x="3" y="2" width="1" height="1" fill="#FF79C6"/><rect x="4" y="2" width="1" height="1" fill="#FF79C6"/><rect x="5" y="2" width="1" height="1" fill="#FF79C6"/><rect x="6" y="2" width="1" height="1" fill="#FF79C6"/><rect x="7" y="2" width="1" height="1" fill="#FF79C6"/><rect x="0" y="3" width="1" height="1" fill="#FF79C6"/><rect x="1" y="3" width="1" height="1" fill="#FF79C6"/><rect x="3" y="3" width="1" height="1" fill="#FF79C6"/><rect x="4" y="3" width="1" height="1" fill="#FF79C6"/><rect x="6" y="3" width="1" height="1" fill="#FF79C6"/><rect x="7" y="3" width="1" height="1" fill="#FF79C6"/><rect x="0" y="4" width="1" height="1" fill="#FF79C6"/><rect x="1" y="4" width="1" height="1" fill="#FF79C6"/><rect x="3" y="4" width="1" height="1" fill="#FF79C6"/><rect x="4" y="4" width="1" height="1" fill="#FF79C6"/><rect x="6" y="4" width="1" height="1" fill="#FF79C6"/><rect x="7" y="4" width="1" height="1" fill="#FF79C6"/><rect x="0" y="5" width="1" height="1" fill="#FF79C6"/><rect x="1" y="5" width="1" height="1" fill="#FF79C6"/><rect x="2" y="5" width="1" height="1" fill="#FF79C6"/><rect x="5" y="5" width="1" height="1" fill="#FF79C6"/><rect x="6" y="5" width="1" height="1" fill="#FF79C6"/><rect x="7" y="5" width="1" height="1" fill="#FF79C6"/><rect x="1" y="6" width="1" height="1" fill="#FF79C6"/><rect x="2" y="6" width="1" height="1" fill="#FF79C6"/><rect x="3" y="6" width="1" height="1" fill="#FF79C6"/><rect x="4" y="6" width="1" height="1" fill="#FF79C6"/><rect x="5" y="6" width="1" height="1" fill="#FF79C6"/><rect x="6" y="6" width="1" height="1" fill="#FF79C6"/><rect x="2" y="7" width="1" height="1" fill="#FF79C6"/><rect x="3" y="7" width="1" height="1" fill="#FF79C6"/><rect x="4" y="7" width="1" height="1" fill="#FF79C6"/><rect x="5" y="7" width="1" height="1" fill="#FF79C6"/><rect x="3" y="1" width="1" height="1" fill="#FFB8E0"/><rect x="4" y="1" width="1" height="1" fill="#FFB8E0"/><rect x="2" y="3" width="1" height="1" fill="#191A21"/><rect x="5" y="3" width="1" height="1" fill="#191A21"/><rect x="2" y="4" width="1" height="1" fill="#191A21"/><rect x="5" y="4" width="1" height="1" fill="#191A21"/><rect x="3" y="5" width="1" height="1" fill="#191A21"/><rect x="4" y="5" width="1" height="1" fill="#191A21"/></g></svg> LOOT ANALYZER</h1>
  </div>

  <!-- Input form -->
  <div class="bg-stone-900 border border-amber-900/40 rounded-xl p-6 mb-6 shadow-lg">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      <!-- Server selector -->
      <div>
        <label class="block text-amber-400 text-xs font-semibold mb-1 uppercase tracking-wider">Your Server</label>
        <select id="server-select"
                class="w-full bg-stone-800 border border-amber-900/50 text-amber-100 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-amber-500">
          <option value="">— Select server —</option>
          <% @servers.each do |s| %>
            <option value="<%= s %>"><%= s %></option>
          <% end %>
        </select>
      </div>

      <!-- Tip -->
    </div>

    <!-- Paste area -->
    <label class="block text-amber-400 text-xs font-semibold mb-1 uppercase tracking-wider">Loot Text</label>
    <textarea id="loot-input"
              rows="5"
              placeholder="Paste Hunt Analyser :)"
              class="w-full bg-stone-800 border border-amber-900/50 text-amber-100 rounded-lg px-4 py-3 text-sm resize-y
                     placeholder-stone-500 focus:outline-none focus:border-amber-500 font-mono"></textarea>

    <div class="mt-4 flex gap-3">
      <button id="analyze-btn"
              class="bg-amber-700 hover:bg-amber-600 text-white font-bold px-6 py-2 rounded-lg transition-colors text-sm shadow">
        Analyze Loot
      </button>
      <button id="clear-btn"
              class="bg-stone-700 hover:bg-stone-600 text-stone-200 font-semibold px-4 py-2 rounded-lg transition-colors text-sm">
        Clear
      </button>
    </div>
  </div>

  <!-- Status / loading -->
  <div id="status-bar" class="hidden text-center py-4 text-amber-300 text-sm"></div>

  <!-- Results summary -->
  <div id="summary-bar" class="hidden bg-stone-900 border border-amber-900/40 rounded-xl px-6 py-5 mb-4 shadow">
    <p class="text-stone-500 text-xs uppercase tracking-wider mb-3">
      <span id="sum-parsed">—</span> items analyzed
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="bg-stone-800/70 rounded-xl px-5 py-4">
        <p class="text-stone-400 text-xs uppercase tracking-wider mb-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8" width="16" height="16" style="image-rendering:pixelated;shape-rendering:crispEdges;display:inline;vertical-align:middle;margin-right:4px"><style>@keyframes mgmb{0%{fill:#BD93F9}40%{fill:#F1FA8C}60%{fill:#F1FA8C}100%{fill:#BD93F9}}.mgmb{animation:mgmb 1.2s ease-in-out infinite}</style><rect x="3" y="0" width="1" height="1" fill="#BD93F9"/><rect x="4" y="0" width="1" height="1" fill="#BD93F9"/><rect x="2" y="1" width="1" height="1" fill="#BD93F9"/><rect x="3" y="1" width="1" height="1" fill="#BD93F9"/><rect x="4" y="1" width="1" height="1" fill="#BD93F9"/><rect x="5" y="1" width="1" height="1" fill="#BD93F9"/><rect x="1" y="2" width="1" height="1" fill="#BD93F9"/><rect x="2" y="2" width="1" height="1" fill="#BD93F9"/><rect x="3" y="2" width="1" height="1" fill="#BD93F9"/><rect x="4" y="2" width="1" height="1" fill="#BD93F9"/><rect x="5" y="2" width="1" height="1" fill="#BD93F9"/><rect x="6" y="2" width="1" height="1" fill="#BD93F9"/><rect x="0" y="3" width="1" height="1" fill="#BD93F9"/><rect x="1" y="3" width="1" height="1" fill="#BD93F9"/><rect x="2" y="3" width="1" height="1" fill="#BD93F9"/><rect x="3" y="3" width="1" height="1" fill="#BD93F9"/><rect x="4" y="3" width="1" height="1" fill="#BD93F9"/><rect x="5" y="3" width="1" height="1" fill="#BD93F9"/><rect x="6" y="3" width="1" height="1" fill="#BD93F9"/><rect x="7" y="3" width="1" height="1" fill="#BD93F9"/><rect x="0" y="4" width="1" height="1" fill="#BD93F9"/><rect x="1" y="4" width="1" height="1" fill="#BD93F9"/><rect x="2" y="4" width="1" height="1" fill="#BD93F9"/><rect class="mgmb" x="3" y="4" width="1" height="1" fill="#BD93F9"/><rect class="mgmb" x="4" y="4" width="1" height="1" fill="#BD93F9"/><rect x="5" y="4" width="1" height="1" fill="#BD93F9"/><rect x="6" y="4" width="1" height="1" fill="#BD93F9"/><rect x="7" y="4" width="1" height="1" fill="#BD93F9"/><rect x="0" y="5" width="1" height="1" fill="#BD93F9"/><rect x="1" y="5" width="1" height="1" fill="#BD93F9"/><rect x="2" y="5" width="1" height="1" fill="#BD93F9"/><rect x="3" y="5" width="1" height="1" fill="#BD93F9"/><rect x="4" y="5" width="1" height="1" fill="#BD93F9"/><rect x="5" y="5" width="1" height="1" fill="#BD93F9"/><rect x="6" y="5" width="1" height="1" fill="#BD93F9"/><rect x="7" y="5" width="1" height="1" fill="#BD93F9"/><rect x="1" y="6" width="1" height="1" fill="#BD93F9"/><rect x="2" y="6" width="1" height="1" fill="#BD93F9"/><rect x="3" y="6" width="1" height="1" fill="#BD93F9"/><rect x="4" y="6" width="1" height="1" fill="#BD93F9"/><rect x="5" y="6" width="1" height="1" fill="#BD93F9"/><rect x="6" y="6" width="1" height="1" fill="#BD93F9"/><rect x="2" y="7" width="1" height="1" fill="#BD93F9"/><rect x="3" y="7" width="1" height="1" fill="#BD93F9"/><rect x="4" y="7" width="1" height="1" fill="#BD93F9"/><rect x="5" y="7" width="1" height="1" fill="#BD93F9"/></svg>Sell all to NPC</p>
        <p id="sum-npc" class="text-green-400 font-bold text-xl font-mono">—</p>
      </div>
      <div class="bg-amber-950/50 border border-amber-800/40 rounded-xl px-5 py-4">
        <p class="text-amber-400/80 text-xs uppercase tracking-wider mb-1">⚡ Best option (Market + NPC)</p>
        <p id="sum-best" class="text-amber-300 font-bold text-xl font-mono">—</p>
        <p id="sum-savings" class="text-xs text-stone-400 mt-1"></p>
      </div>
    </div>
  </div>

  <!-- Filter bar (shown after analysis) -->
  <div id="filter-bar" class="hidden mb-3 flex flex-wrap gap-2 text-xs">
    <span class="text-stone-500 self-center mr-1">Filter:</span>
    <button class="filter-btn px-3 py-1.5 rounded-lg font-semibold transition-colors bg-amber-700 text-white" data-verdict="all">All</button>
    <button class="filter-btn px-3 py-1.5 rounded-lg font-semibold transition-colors bg-stone-800 text-stone-300 hover:bg-stone-700" data-verdict="market">📈 Market</button>
    <button class="filter-btn px-3 py-1.5 rounded-lg font-semibold transition-colors bg-stone-800 text-stone-300 hover:bg-stone-700" data-verdict="npc">💰 NPC</button>
    <button class="filter-btn px-3 py-1.5 rounded-lg font-semibold transition-colors bg-stone-800 text-stone-300 hover:bg-stone-700" data-verdict="currency">💰 Currency</button>
  </div>

  <!-- Results table -->
  <div id="results-container" class="hidden bg-stone-900 border border-amber-900/40 rounded-xl overflow-hidden shadow-lg">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-amber-900/40 text-amber-400 text-xs uppercase tracking-wider">
          <th class="px-4 py-3 text-left w-10"></th>
          <th class="px-4 py-3 text-left">Item</th>
          <th class="px-4 py-3 text-center">Qty</th>
          <th class="px-4 py-3 text-right">NPC Price</th>
          <th class="px-4 py-3 text-right">NPC Total</th>
          <th class="px-4 py-3 text-right">Market Price</th>
          <th class="px-4 py-3 text-right">Market Total</th>
          <th class="px-4 py-3 text-center">Sell To</th>
        </tr>
      </thead>
      <tbody id="results-body" class="divide-y divide-stone-800">
      </tbody>
    </table>
  </div>

  <!-- Unrecognized items -->
  <div id="unknown-container" class="hidden mt-4 bg-stone-900 border border-red-900/40 rounded-xl p-4 text-sm">
    <p class="text-red-400 font-semibold mb-2">⚠️ Items not found in database:</p>
    <p id="unknown-list" class="text-stone-400"></p>
    <p class="text-stone-500 text-xs mt-2">Run <code class="bg-stone-800 px-1 rounded">rake tibia:import</code> to fetch the full item list from TibiaWiki.</p>
  </div>
</div>

<script>
const ANALYZE_URL  = "<%= analyze_loot_path %>";
const MARKET_API   = "/items/market_prices";  // Rails proxy — avoids CORS
const CSRF_TOKEN   = document.querySelector('meta[name="csrf-token"]')?.content;

const analyzeBtn  = document.getElementById("analyze-btn");
const clearBtn    = document.getElementById("clear-btn");
const lootInput   = document.getElementById("loot-input");
const serverSel   = document.getElementById("server-select");
const statusBar   = document.getElementById("status-bar");
const summaryBar  = document.getElementById("summary-bar");
const resultsContainer = document.getElementById("results-container");
const resultsBody = document.getElementById("results-body");
const unknownContainer = document.getElementById("unknown-container");

function gp(n) {
  if (n <= 0) return '<span class="text-stone-500">—</span>';
  return n.toLocaleString() + ' <span class="text-amber-600 text-xs">gp</span>';
}

function setStatus(msg, cls = "text-amber-300") {
  statusBar.className = `text-center py-4 text-sm ${cls}`;
  statusBar.innerHTML = msg;
  statusBar.classList.remove("hidden");
}

function clearStatus() { statusBar.classList.add("hidden"); }

clearBtn.addEventListener("click", () => {
  lootInput.value = "";
  statusBar.classList.add("hidden");
  summaryBar.classList.add("hidden");
  resultsContainer.classList.add("hidden");
  unknownContainer.classList.add("hidden");
  resultsBody.innerHTML = "";
  lootInput.focus();
});

analyzeBtn.addEventListener("click", async () => {
  const loot   = lootInput.value.trim();
  const server = serverSel.value;

  if (!loot) { setStatus("⚠️ Paste some loot text first.", "text-red-400"); return; }
  if (!server) { setStatus("⚠️ Select your server first.", "text-red-400"); return; }

  analyzeBtn.disabled = true;
  analyzeBtn.textContent = "Analyzing…";
  setStatus("🔍 Parsing loot…");
  summaryBar.classList.add("hidden");
  resultsContainer.classList.add("hidden");
  unknownContainer.classList.add("hidden");
  resultsBody.innerHTML = "";

  // Step 1: Parse + get NPC prices from Rails
  let data;
  try {
    const resp = await fetch(ANALYZE_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": CSRF_TOKEN,
        "Accept": "application/json"
      },
      body: JSON.stringify({ loot_text: loot, server })
    });
    data = await resp.json();
    if (!resp.ok) { setStatus(`❌ ${data.error || "Server error"}`, "text-red-400"); return; }
  } catch(e) {
    setStatus("❌ Could not reach the server.", "text-red-400");
    return;
  } finally {
    analyzeBtn.disabled = false;
    analyzeBtn.textContent = "Analyze Loot";
  }

  const { results, market_ids } = data;
  if (!results || results.length === 0) {
    setStatus("No recognizable items found in your loot text.", "text-stone-400");
    return;
  }

  // Render table with NPC data (market = loading...)
  const rowMap = {}; // market_item_id -> row element
  const found    = results.filter(r => r.found);
  const unfound  = results.filter(r => !r.found);

  found.forEach(r => {
    const tr = document.createElement("tr");
    tr.className = "hover:bg-stone-800/50 transition-colors";
    const imgCell = r.image_url
      ? `<img src="${r.image_url}" alt="${r.matched_name}" class="w-8 h-8 object-contain mx-auto" onerror="this.style.display='none'">`
      : '<span class="text-stone-600 text-lg">?</span>';

    if (r.is_currency) {
      tr.classList.add('verdict-currency');
      tr.innerHTML = `
        <td class="px-4 py-3 text-center">${imgCell}</td>
        <td class="px-4 py-3">
          <div class="text-amber-100 font-medium">${r.matched_name}</div>
          <div class="text-xs text-amber-700/70">currency</div>
        </td>
        <td class="px-4 py-3 text-center text-stone-300">${r.quantity}</td>
        <td class="px-4 py-3 text-right font-mono text-amber-400">${gp(r.npc_buy_price)}<span class="text-xs text-stone-500 ml-1">ea</span></td>
        <td class="px-4 py-3 text-right font-mono text-amber-300">${gp(r.npc_total)}</td>
        <td class="px-4 py-3 text-right text-stone-600 text-xs">—</td>
        <td class="px-4 py-3 text-right text-stone-600 text-xs">—</td>
        <td class="px-4 py-3 text-center">
          <span class="bg-amber-900/50 text-amber-400 px-2 py-0.5 rounded text-xs font-semibold">💰 Currency</span>
        </td>
      `;
    } else {
      const npcWikiUrl = r.best_npc_buyer
        ? `https://www.tibiawiki.com.br/wiki/${encodeURIComponent(r.best_npc_buyer.replace(/ /g, '_'))}`
        : '';
      const npcSubtext = r.best_npc_buyer
        ? `<div class="text-xs text-stone-400"><a href="${npcWikiUrl}" target="_blank" class="hover:underline" style="color:#C4621D">${r.best_npc_buyer}</a>${r.npc_location ? ' · ' + r.npc_location : ''}</div>`
        : '';
      tr.innerHTML = `
        <td class="px-4 py-3 text-center">${imgCell}</td>
        <td class="px-4 py-3">
          <div class="text-amber-100 font-medium">${r.matched_name}</div>
          ${npcSubtext}
        </td>
        <td class="px-4 py-3 text-center text-stone-300">${r.quantity}</td>
        <td class="px-4 py-3 text-right font-mono text-green-400">${gp(r.npc_buy_price)}</td>
        <td class="px-4 py-3 text-right font-mono text-green-300">${gp(r.npc_total)}</td>
        <td class="px-4 py-3 text-right font-mono market-price" data-id="${r.market_item_id || ''}">
          <span class="text-stone-500 animate-pulse text-xs">loading…</span>
        </td>
        <td class="px-4 py-3 text-right font-mono market-total" data-qty="${r.quantity}" data-npc="${r.npc_total}">
          <span class="text-stone-500">…</span>
        </td>
        <td class="px-4 py-3 text-center sell-verdict">
          <span class="text-stone-500">…</span>
        </td>
      `;
      if (r.market_item_id) rowMap[r.market_item_id] = tr;
    }
    resultsBody.appendChild(tr);
  });

  resultsContainer.classList.remove("hidden");
  document.getElementById("filter-bar").classList.remove("hidden");
  clearStatus();

  if (unfound.length > 0) {
    document.getElementById("unknown-list").textContent = unfound.map(r => `"${r.original_name}"`).join(", ");
    unknownContainer.classList.remove("hidden");
  }

  // Step 2: Fetch market prices from TibiaMarket API
  if (market_ids.length > 0) {
    setStatus(`📈 Fetching market prices from TibiaMarket (server: ${server})…`);
    try {
      const url = `${MARKET_API}?server=${encodeURIComponent(server)}&item_ids=${market_ids.join(",")}`;
      const mResp = await fetch(url);
      const mData = await mResp.json();

      // Build map: market_item_id -> market data
      const marketMap = {};
      (mData || []).forEach(m => { marketMap[m.id] = m; });

      let totalNPC = 0, totalBest = 0;

      // Update each row
      found.forEach(r => {
        totalNPC += r.npc_total;

        // Currency rows: best = gold value, no market lookup
        if (r.is_currency) {
          totalBest += r.npc_total;
          return;
        }

        const tr = rowMap[r.market_item_id];
        if (!tr) {
          // No market ID — NPC is the best we can do
          totalBest += r.npc_total;
          // Find row by matched_name and mark verdict
          const rows = resultsBody.querySelectorAll('tr:not(.verdict-currency)');
          rows.forEach(row => {
            const name = row.querySelector('td:nth-child(2) .text-amber-100')?.textContent?.trim();
            if (name === r.matched_name && !row.classList.contains('verdict-npc')) {
              row.classList.add(r.npc_total > 0 ? 'verdict-npc' : 'verdict-nodata');
            }
          });
          return;
        }

        const mRow   = r.market_item_id ? marketMap[r.market_item_id] : null;
        const mPrice = mRow ? (mRow.buy_offer > 0 ? mRow.buy_offer : mRow.month_average_buy) : -1;
        const mTotal = mPrice > 0 ? mPrice * r.quantity : -1;

        // Best per item = whichever pays more
        totalBest += mTotal > r.npc_total ? mTotal : r.npc_total;

        const priceCell   = tr.querySelector(".market-price");
        const totalCell   = tr.querySelector(".market-total");
        const verdictCell = tr.querySelector(".sell-verdict");

        if (mPrice > 0) {
          priceCell.innerHTML = `<span class="text-sky-400">${gp(mPrice)}</span>`;
          totalCell.innerHTML  = `<span class="text-sky-300">${gp(mTotal)}</span>`;

          if (mTotal > r.npc_total * 1.1) {
            verdictCell.innerHTML = '<span class="bg-sky-900/60 text-sky-300 px-2 py-0.5 rounded text-xs font-semibold">📈 Market</span>';
            tr.classList.add("bg-sky-950/10", "verdict-market");
          } else if (r.npc_total > 0 && r.npc_total >= mTotal) {
            verdictCell.innerHTML = '<span class="bg-green-900/60 text-green-300 px-2 py-0.5 rounded text-xs font-semibold">💰 NPC</span>';
            tr.classList.add("bg-green-950/10", "verdict-npc");
          } else {
            verdictCell.innerHTML = '<span class="bg-stone-700/60 text-stone-300 px-2 py-0.5 rounded text-xs font-semibold">≈ Equal</span>';
            tr.classList.add("verdict-equal");
          }
        } else {
          priceCell.innerHTML  = '<span class="text-stone-500 text-xs">No data</span>';
          totalCell.innerHTML  = '<span class="text-stone-500 text-xs">—</span>';
          if (r.npc_total > 0) {
            verdictCell.innerHTML = '<span class="bg-green-900/60 text-green-300 px-2 py-0.5 rounded text-xs font-semibold">💰 NPC</span>';
            tr.classList.add("verdict-npc");
          } else {
            verdictCell.innerHTML = '<span class="text-stone-500 text-xs">—</span>';
            tr.classList.add("verdict-nodata");
          }
        }
      });

      // Summary bar
      document.getElementById("sum-parsed").textContent = results.length;
      document.getElementById("sum-npc").innerHTML  = gp(totalNPC);
      document.getElementById("sum-best").innerHTML = gp(totalBest);

      const savings = totalBest - totalNPC;
      const savingsEl = document.getElementById("sum-savings");
      if (savings > 100) {
        savingsEl.innerHTML = `+${gp(savings)} vs NPC only (+${Math.round(savings / Math.max(totalNPC, 1) * 100)}%)`;
      } else {
        savingsEl.textContent = "Same as NPC prices";
      }

      summaryBar.classList.remove("hidden");
      clearStatus();

    } catch(e) {
      setStatus("⚠️ Could not fetch market prices (API may be down). NPC prices shown.", "text-amber-400");
      found.forEach(r => {
        const tr = rowMap[r.market_item_id];
        if (!tr) return;
        tr.querySelector(".market-price").innerHTML = '<span class="text-red-500 text-xs">API error</span>';
        tr.querySelector(".market-total").innerHTML = '<span class="text-stone-500">—</span>';
        if (r.npc_total > 0) {
          tr.querySelector(".sell-verdict").innerHTML = '<span class="bg-green-900/60 text-green-300 px-2 py-0.5 rounded text-xs font-semibold">💰 NPC</span>';
        } else {
          tr.querySelector(".sell-verdict").innerHTML = '<span class="text-stone-500">—</span>';
        }
      });
    }
  } else {
    // No market IDs — no market data available
    setStatus("⚠️ No market IDs found. Run <code>rake tibia:sync_market_ids</code> to enable market comparison.", "text-amber-400");
    found.forEach(r => {
      const tr = rowMap[r.market_item_id];
      if (!tr) return;
      tr.querySelector(".market-price").innerHTML = '<span class="text-stone-500 text-xs">Run sync</span>';
      tr.querySelector(".market-total").innerHTML = '<span class="text-stone-500">—</span>';
      tr.querySelector(".sell-verdict").innerHTML = r.npc_total > 0
        ? '<span class="bg-green-900/60 text-green-300 px-2 py-0.5 rounded text-xs font-semibold">💰 NPC</span>'
        : '<span class="text-stone-500">—</span>';
    });
  }
});

// Filter buttons
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('bg-amber-700', 'text-white');
      b.classList.add('bg-stone-800', 'text-stone-300');
    });
    btn.classList.add('bg-amber-700', 'text-white');
    btn.classList.remove('bg-stone-800', 'text-stone-300');
    const v = btn.dataset.verdict;
    document.querySelectorAll('#results-body tr').forEach(row => {
      if (v === 'all' || row.classList.contains('verdict-' + v)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });
});

// Reset filters when a new analysis starts
analyzeBtn.addEventListener('click', () => {
  document.querySelectorAll('.filter-btn').forEach((b, i) => {
    if (i === 0) { b.classList.add('bg-amber-700','text-white'); b.classList.remove('bg-stone-800','text-stone-300'); }
    else { b.classList.remove('bg-amber-700','text-white'); b.classList.add('bg-stone-800','text-stone-300'); }
  });
  document.getElementById("filter-bar").classList.add("hidden");
}, true);

// Allow Ctrl+Enter to analyze
lootInput.addEventListener("keydown", e => {
  if (e.ctrlKey && e.key === "Enter") analyzeBtn.click();
});
</script>
