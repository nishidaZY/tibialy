<% content_for :title, "Loot Analyzer – TibiaLootFinder" %>

<div id="sweep-anchor"></div>
<section class="grid grid-cols-1 lg:grid-cols-[1fr_1.35fr] gap-4 mb-4">
  <div class="card p-6 sm:p-8 flex flex-col" data-rise style="--d:0">
    <p class="label mb-3">Loot Analyzer</p>
    <h1 class="serif text-[34px] sm:text-[42px] leading-[1.05]">Sell each item where it pays <span class="text-amber-400">the most</span>.</h1>
    <p class="text-stone-400 text-[15px] mt-3">Copy the loot from Tibia's Hunt Analyser and paste it here. Every item is priced at its best NPC buyer and on your world's Market.</p>
    <ol class="mt-6 space-y-3 text-[13.5px] text-stone-300">
      <li class="flex gap-3"><span class="num text-stone-500 w-4">1</span> Pick your world</li>
      <li class="flex gap-3"><span class="num text-stone-500 w-4">2</span> Paste the Hunt Analyser text</li>
      <li class="flex gap-3"><span class="num text-stone-500 w-4">3</span> Analyze. <span class="kbd ml-1">Ctrl ↵</span></li>
    </ol>
    <%# figura de traço fino: um saco de loot que inclina para o ponteiro e solta moedas %>
    <div id="loot-figure" class="hidden lg:block mt-auto self-end w-[190px] pt-4" aria-hidden="true" style="--hairline-plate:#161513;--hairline-hi:#e3b04a;--hairline-edge:#a19d96;--hairline-mid:#57534e;--hairline-lo:#2a2826;--hairline-stroke:0.9"></div>
  </div>

  <div class="card p-6" data-rise style="--d:1">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <label for="server-select" class="label block mb-1.5">Your world</label>
        <select id="server-select" class="field">
          <option value="">Select a world</option>
          <% @servers.each do |s| %>
            <option value="<%= s %>"><%= s %></option>
          <% end %>
        </select>
      </div>
    </div>

    <label for="loot-input" class="label block mb-1.5">Loot text</label>
    <textarea id="loot-input" rows="7" placeholder="Paste your Hunt Analyser here…" class="field font-mono text-[13px] resize-y"></textarea>

    <div class="mt-4 flex gap-2">
      <button id="analyze-btn" class="btn-primary">Analyze loot</button>
      <button id="clear-btn" class="btn btn-ghost">Clear</button>
    </div>
  </div>
</section>

<div id="status-bar" class="hidden text-center py-4 text-sm"></div>

<!-- Summary -->
<section id="summary-bar" class="reveal hidden grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
  <div class="card p-5">
    <p class="label">Items analyzed</p>
    <p id="sum-parsed" class="serif text-[40px] leading-none num mt-4">—</p>
  </div>
  <div class="card p-5">
    <p class="label">Sell everything to NPCs</p>
    <p class="serif text-[40px] leading-none num mt-4"><span id="sum-npc" class="text-amber-400">—</span></p>
  </div>
  <div class="card p-5 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(120% 90% at 100% 0%, rgba(95,207,146,.10), transparent 60%)"></div>
    <p class="label">Best option · Market + NPC</p>
    <p class="serif text-[40px] leading-none num mt-4"><span id="sum-best" class="text-green-400">—</span></p>
    <p id="sum-savings" class="text-xs text-stone-400 mt-2"></p>
  </div>
</section>

<!-- Filter + sort -->
<div id="filter-bar" class="reveal hidden mb-3 flex flex-wrap gap-3 items-center">
  <div class="seg">
    <button class="filter-btn bg-amber-700 text-white" data-verdict="all">All</button>
    <button class="filter-btn bg-stone-800 text-stone-300" data-verdict="market">Market</button>
    <button class="filter-btn bg-stone-800 text-stone-300" data-verdict="npc">NPC</button>
    <button class="filter-btn bg-stone-800 text-stone-300" data-verdict="currency">Currency</button>
  </div>
  <div class="seg">
    <button id="sort-high" class="sort-btn bg-amber-700 text-white">Highest</button>
    <button id="sort-low"  class="sort-btn bg-stone-800 text-stone-300">Lowest</button>
  </div>
</div>

<!-- Results -->
<section id="results-container" class="reveal hidden card overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th class="w-12"></th>
        <th>Item</th>
        <th class="text-center">Qty</th>
        <th class="text-right">NPC price</th>
        <th class="text-right">NPC total</th>
        <th class="text-right">Market price</th>
        <th class="text-right">Market total</th>
        <th class="text-center">Sell to</th>
      </tr>
    </thead>
    <tbody id="results-body" class="stagger"></tbody>
  </table>
</section>

<!-- Unrecognized items -->
<section id="unknown-container" class="reveal hidden card mt-4 p-5 text-sm" style="border-color:rgba(240,82,79,.3)">
  <p class="font-medium text-[#f0524f] mb-1">Items not found in the database</p>
  <p id="unknown-list" class="text-stone-400"></p>
  <p class="text-stone-500 text-xs mt-2">Run <code class="kbd">rake tibia:import</code> to fetch the full item list from TibiaWiki.</p>
</section>

<script>
const ANALYZE_URL  = "<%= analyze_loot_path %>";
const MARKET_API   = "/items/market_prices";  // Rails proxy — avoids CORS
const CSRF_TOKEN   = document.querySelector('meta[name="csrf-token"]')?.content;

const analyzeBtn  = document.getElementById("analyze-btn");
const clearBtn    = document.getElementById("clear-btn");
const lootInput   = document.getElementById("loot-input");
const serverSel   = document.getElementById("server-select");
const statusBar   = document.getElementById("status-bar");
const summaryBar  = document.getElementById("summary-bar");
const resultsContainer = document.getElementById("results-container");
const resultsBody = document.getElementById("results-body");
const unknownContainer = document.getElementById("unknown-container");

// the world is shared with the other pages (and shown in the header)
try { const w = localStorage.getItem("tibia_world"); if (w) serverSel.value = w; } catch (e) {}
serverSel.addEventListener("change", () => { try { localStorage.setItem("tibia_world", serverSel.value); } catch (e) {} TLFUI.showWorld(); });

// ── Security: HTML-escape values injected into innerHTML ───────────────────
function escapeHtml(s) {
  if (s == null) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                  .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
// Allow only http/https image URLs (blocks javascript: data: etc.)
function safeUrl(u) {
  if (!u) return '';
  return /^https?:\/\//i.test(u) ? String(u) : '';
}

// ── Filter / sort state ────────────────────────────────────────────────────
let currentVerdict = 'all';
let currentSort    = 'high';

function applyFilterAndSort() {
  const rows = Array.from(resultsBody.querySelectorAll('tr'));
  rows.forEach(row => {
    row.style.display = (currentVerdict === 'all' || row.classList.contains('verdict-' + currentVerdict)) ? '' : 'none';
  });
  const visible = rows.filter(r => r.style.display !== 'none');
  visible.sort((a, b) => {
    const av = parseFloat(a.dataset.bestTotal) || 0;
    const bv = parseFloat(b.dataset.bestTotal) || 0;
    return currentSort === 'high' ? bv - av : av - bv;
  });
  visible.forEach(r => resultsBody.appendChild(r));
}

function gp(n) {
  if (n <= 0) return '<span class="text-stone-600">—</span>';
  return '<span class="num">' + Math.round(n).toLocaleString() + '</span> <span class="text-stone-500 text-xs">gp</span>';
}

function setStatus(msg, cls = "text-stone-300") {
  statusBar.className = `text-center py-4 text-sm ${cls}`;
  statusBar.innerHTML = msg;
  statusBar.classList.remove("hidden");
}

function clearStatus() { statusBar.classList.add("hidden"); }

clearBtn.addEventListener("click", () => {
  currentVerdict = 'all';
  currentSort    = 'high';
  lootInput.value = "";
  statusBar.classList.add("hidden");
  summaryBar.classList.add("hidden");
  resultsContainer.classList.add("hidden");
  unknownContainer.classList.add("hidden");
  document.getElementById("filter-bar").classList.add("hidden");
  resultsBody.innerHTML = "";
  lootInput.focus();
});

analyzeBtn.addEventListener("click", async () => {
  const loot   = lootInput.value.trim();
  const server = serverSel.value;

  if (!loot) { setStatus("Paste some loot text first.", "text-red-400"); return; }
  if (!server) { setStatus("Select your server first.", "text-red-400"); return; }
  if (loot.length > 100000) { setStatus("Loot text too large (max 100 000 characters).", "text-red-400"); return; }

  analyzeBtn.disabled = true;
  analyzeBtn.textContent = "Analyzing…";
  setStatus("Parsing loot…");
  summaryBar.classList.add("hidden");
  resultsContainer.classList.add("hidden");
  unknownContainer.classList.add("hidden");
  resultsBody.innerHTML = "";

  // Step 1: Parse + get NPC prices from Rails
  let data;
  try {
    const resp = await fetch(ANALYZE_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": CSRF_TOKEN,
        "Accept": "application/json"
      },
      body: JSON.stringify({ loot_text: loot, server })
    });
    data = await resp.json();
    if (!resp.ok) { setStatus(`${data.error || "Server error"}`, "text-red-400"); return; }
  } catch(e) {
    setStatus("Could not reach the server.", "text-red-400");
    return;
  } finally {
    analyzeBtn.disabled = false;
    analyzeBtn.textContent = "Analyze loot";
  }

  const { results, market_ids } = data;
  if (!results || results.length === 0) {
    setStatus("No recognizable items found in your loot text.", "text-stone-400");
    return;
  }

  // Render table with NPC data (market = loading...)
  const rowMap = {}; // market_item_id -> row element
  const found    = results.filter(r => r.found);
  const unfound  = results.filter(r => !r.found);

  found.forEach(r => {
    const tr = document.createElement("tr");
    tr.className = "";
    const imgSrc  = safeUrl(r.image_url);
    const imgCell = imgSrc
      ? `<div class="w-9 h-9 rounded-lg bg-stone-900 border border-white/5 grid place-items-center mx-auto"><img src="${imgSrc}" alt="" class="w-8 h-8 object-contain sprite" onerror="this.style.display='none'"></div>`
      : '<span class="text-stone-600">?</span>';
    tr.dataset.bestTotal = r.npc_total || 0;

    if (r.is_currency) {
      tr.classList.add('verdict-currency');
      tr.innerHTML = `
        <td class="px-4 py-3 text-center">${imgCell}</td>
        <td class="px-4 py-3">
          <div class="text-amber-100 font-medium">${escapeHtml(r.matched_name)}</div>
          <div class="text-xs text-amber-700/70">currency</div>
        </td>
        <td class="px-4 py-3 text-center text-stone-300">${r.quantity}</td>
        <td class="px-4 py-3 text-right text-amber-400">${gp(r.npc_buy_price)}<span class="text-xs text-stone-500 ml-1">ea</span></td>
        <td class="px-4 py-3 text-right text-amber-300">${gp(r.npc_total)}</td>
        <td class="px-4 py-3 text-right text-stone-600 text-xs">—</td>
        <td class="px-4 py-3 text-right text-stone-600 text-xs">—</td>
        <td class="px-4 py-3 text-center">
          <span class="verdict npc">Currency</span>
        </td>
      `;
    } else {
      const npcWikiUrl = r.best_npc_buyer
        ? `https://www.tibiawiki.com.br/wiki/${encodeURIComponent(r.best_npc_buyer.replace(/ /g, '_'))}`
        : '';
      const npcSubtext = r.best_npc_buyer
        ? `<div class="text-xs text-stone-400"><a href="${npcWikiUrl}" target="_blank" class="hover:text-white text-stone-300">${escapeHtml(r.best_npc_buyer)}</a>${r.npc_location ? ' · ' + escapeHtml(r.npc_location) : ''}</div>`
        : '';
      tr.innerHTML = `
        <td class="px-4 py-3 text-center">${imgCell}</td>
        <td class="px-4 py-3">
          <div class="text-amber-100 font-medium">${escapeHtml(r.matched_name)}</div>
          ${npcSubtext}
        </td>
        <td class="px-4 py-3 text-center text-stone-300">${r.quantity}</td>
        <td class="px-4 py-3 text-right text-amber-400">${gp(r.npc_buy_price)}</td>
        <td class="px-4 py-3 text-right text-amber-300">${gp(r.npc_total)}</td>
        <td class="px-4 py-3 text-right market-price" data-id="${r.market_item_id || ''}">
          <span class="skeleton inline-block w-16 h-4 align-middle">&nbsp;</span>
        </td>
        <td class="px-4 py-3 text-right market-total" data-qty="${r.quantity}" data-npc="${r.npc_total}">
          <span class="text-stone-500">…</span>
        </td>
        <td class="px-4 py-3 text-center sell-verdict">
          <span class="text-stone-500">…</span>
        </td>
      `;
      if (r.market_item_id) rowMap[r.market_item_id] = tr;
    }
    resultsBody.appendChild(tr);
  });

  resultsContainer.classList.remove("hidden");
  document.getElementById("filter-bar").classList.remove("hidden");
  clearStatus();

  if (unfound.length > 0) {
    document.getElementById("unknown-list").textContent = unfound.map(r => `"${r.original_name}"`).join(", ");
    unknownContainer.classList.remove("hidden");
  }

  // Step 2: Fetch market prices from TibiaMarket API
  if (market_ids.length > 0) {
    setStatus(`Fetching ${server} Market prices…`); TLFUI.sweep(true);
    try {
      const url = `${MARKET_API}?server=${encodeURIComponent(server)}&item_ids=${market_ids.join(",")}`;
      const mResp = await fetch(url);
      const mData = await mResp.json();

      // Build map: market_item_id -> market data
      const marketMap = {};
      (mData || []).forEach(m => { marketMap[m.id] = m; });

      let totalNPC = 0, totalBest = 0;

      // Update each row
      found.forEach(r => {
        totalNPC += r.npc_total;

        // Currency rows: best = gold value, no market lookup
        if (r.is_currency) {
          totalBest += r.npc_total;
          return;
        }

        const tr = rowMap[r.market_item_id];
        if (!tr) {
          // No market ID — NPC is the best we can do
          totalBest += r.npc_total;
          // Find row by matched_name and mark verdict
          const rows = resultsBody.querySelectorAll('tr:not(.verdict-currency)');
          rows.forEach(row => {
            const name = row.querySelector('td:nth-child(2) .text-amber-100')?.textContent?.trim();
            if (name === r.matched_name && !row.classList.contains('verdict-npc')) {
              row.classList.add(r.npc_total > 0 ? 'verdict-npc' : 'verdict-nodata');
            }
          });
          return;
        }

        const mRow   = r.market_item_id ? marketMap[r.market_item_id] : null;
        const mPrice = mRow ? (mRow.buy_offer > 0 ? mRow.buy_offer : mRow.month_average_buy) : -1;
        const mTotal = mPrice > 0 ? mPrice * r.quantity : -1;

        // Best per item = whichever pays more
        totalBest += mTotal > r.npc_total ? mTotal : r.npc_total;
        if (tr) tr.dataset.bestTotal = Math.max(r.npc_total, mTotal > 0 ? mTotal : 0);

        const priceCell   = tr.querySelector(".market-price");
        const totalCell   = tr.querySelector(".market-total");
        const verdictCell = tr.querySelector(".sell-verdict");

        if (mPrice > 0) {
          priceCell.innerHTML = `<span class="text-sky-400">${gp(mPrice)}</span>`;
          totalCell.innerHTML  = `<span class="text-sky-300">${gp(mTotal)}</span>`;

          if (mTotal > r.npc_total * 1.1) {
            verdictCell.innerHTML = '<span class="verdict market">Market</span>';
            tr.classList.add("verdict-market");
          } else if (r.npc_total > 0 && r.npc_total >= mTotal) {
            verdictCell.innerHTML = '<span class="verdict npc">NPC</span>';
            tr.classList.add("verdict-npc");
          } else {
            verdictCell.innerHTML = '<span class="verdict equal">≈ Equal</span>';
            tr.classList.add("verdict-equal");
          }
        } else {
          priceCell.innerHTML  = '<span class="text-stone-500 text-xs">No data</span>';
          totalCell.innerHTML  = '<span class="text-stone-500 text-xs">—</span>';
          if (r.npc_total > 0) {
            verdictCell.innerHTML = '<span class="verdict npc">NPC</span>';
            tr.classList.add("verdict-npc");
          } else {
            verdictCell.innerHTML = '<span class="text-stone-500 text-xs">—</span>';
            tr.classList.add("verdict-nodata");
          }
        }
      });

      // Summary bar
      const gpFmt = n => Math.round(n).toLocaleString() + '<span class="text-lg text-stone-500 font-sans"> gp</span>';
      summaryBar.classList.remove("hidden");
      TLFUI.count(document.getElementById("sum-parsed"), results.length);
      TLFUI.count(document.getElementById("sum-npc"), totalNPC, gpFmt);
      TLFUI.count(document.getElementById("sum-best"), totalBest, gpFmt);

      const savings = totalBest - totalNPC;
      const savingsEl = document.getElementById("sum-savings");
      if (savings > 100) {
        savingsEl.innerHTML = `<span class="text-green-400">+${gp(savings)}</span> vs selling everything to NPCs (+${Math.round(savings / Math.max(totalNPC, 1) * 100)}%)`;
      } else {
        savingsEl.textContent = "Same as NPC prices";
      }

      clearStatus(); TLFUI.sweep(false);
      applyFilterAndSort();

    } catch(e) {
      TLFUI.sweep(false);
      setStatus("Could not fetch Market prices (the API may be down). NPC prices shown.", "text-amber-400");
      found.forEach(r => {
        const tr = rowMap[r.market_item_id];
        if (!tr) return;
        tr.querySelector(".market-price").innerHTML = '<span class="text-[#f0524f] text-xs">API error</span>';
        tr.querySelector(".market-total").innerHTML = '<span class="text-stone-500">—</span>';
        if (r.npc_total > 0) {
          tr.querySelector(".sell-verdict").innerHTML = '<span class="verdict npc">NPC</span>';
        } else {
          tr.querySelector(".sell-verdict").innerHTML = '<span class="text-stone-500">—</span>';
        }
      });
    }
  } else {
    // No market IDs — no market data available
    setStatus("No market IDs found. Run <code>rake tibia:sync_market_ids</code> to enable market comparison.", "text-amber-400");
    found.forEach(r => {
      const tr = rowMap[r.market_item_id];
      if (!tr) return;
      tr.querySelector(".market-price").innerHTML = '<span class="text-stone-500 text-xs">Run sync</span>';
      tr.querySelector(".market-total").innerHTML = '<span class="text-stone-500">—</span>';
      tr.querySelector(".sell-verdict").innerHTML = r.npc_total > 0
        ? '<span class="verdict npc">NPC</span>'
        : '<span class="text-stone-500">—</span>';
    });
  }
});

// Filter buttons
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('bg-amber-700', 'text-white');
      b.classList.add('bg-stone-800', 'text-stone-300');
    });
    btn.classList.add('bg-amber-700', 'text-white');
    btn.classList.remove('bg-stone-800', 'text-stone-300');
    currentVerdict = btn.dataset.verdict;
    applyFilterAndSort();
  });
});

// Sort buttons
document.querySelectorAll('.sort-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.sort-btn').forEach(b => {
      b.classList.remove('bg-amber-700', 'text-white');
      b.classList.add('bg-stone-800', 'text-stone-300');
    });
    btn.classList.add('bg-amber-700', 'text-white');
    btn.classList.remove('bg-stone-800', 'text-stone-300');
    currentSort = (btn.id === 'sort-high') ? 'high' : 'low';
    applyFilterAndSort();
  });
});

// Reset filters/sort when a new analysis starts
analyzeBtn.addEventListener('click', () => {
  currentVerdict = 'all';
  currentSort    = 'high';
  document.querySelectorAll('.filter-btn').forEach((b, i) => {
    if (i === 0) { b.classList.add('bg-amber-700','text-white'); b.classList.remove('bg-stone-800','text-stone-300'); }
    else { b.classList.remove('bg-amber-700','text-white'); b.classList.add('bg-stone-800','text-stone-300'); }
  });
  document.querySelectorAll('.sort-btn').forEach((b, i) => {
    if (i === 0) { b.classList.add('bg-amber-700','text-white'); b.classList.remove('bg-stone-800','text-stone-300'); }
    else { b.classList.remove('bg-amber-700','text-white'); b.classList.add('bg-stone-800','text-stone-300'); }
  });
  document.getElementById("filter-bar").classList.add("hidden");
}, true);

// Allow Ctrl+Enter to analyze
lootInput.addEventListener("keydown", e => {
  if (e.ctrlKey && e.key === "Enter") analyzeBtn.click();
});
</script>

<script type="module">
  import { lootBag } from "/figures/figures.js?v=<%= File.mtime(Rails.root.join("public/figures/figures.js")).to_i %>";
  const el = document.getElementById("loot-figure");
  if (el && matchMedia("(min-width: 1024px)").matches) lootBag(el);
</script>
