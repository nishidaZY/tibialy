<% content_for :title, "Stash Analyzer – TibiaLootFinder" %>

<section class="grid grid-cols-1 lg:grid-cols-[1fr_1.35fr] gap-4 mb-4">
  <div class="card p-6 sm:p-8" data-rise style="--d:0">
    <p class="label mb-3 flex items-center gap-2"><span class="live"></span> Runs in your browser · nothing is uploaded</p>
    <h1 class="serif text-[34px] sm:text-[42px] leading-[1.05]">Your whole stash, priced from <span class="text-amber-400">one screenshot</span>.</h1>
    <p class="text-stone-400 text-[15px] mt-3">Paste a screenshot of your Stash, drag a box around the item slots and every item and amount is recognised and priced.</p>

    <details class="mt-6 group rounded-xl border border-white/10 bg-stone-950/60 px-4 py-3 text-[13.5px]" open>
      <summary class="cursor-pointer select-none font-medium flex items-center justify-between list-none">
        Amounts small or blurry? Zoom in first
        <span class="text-stone-500 transition-transform group-open:rotate-45 text-lg leading-none">+</span>
      </summary>
      <ol class="mt-3 space-y-2 text-stone-400">
        <li class="flex gap-3"><span class="num text-stone-500 w-4 shrink-0">1</span><span>Open your stash in Tibia and sort it by <strong class="text-stone-200">Name</strong>.</span></li>
        <li class="flex gap-3"><span class="num text-stone-500 w-4 shrink-0">2</span><span>Zoom in until the numbers on the items are big and clear, then screenshot the zoomed stash. Use an image viewer, or the system zoom:
          <span class="kbd">Win</span> <span class="kbd">+</span> on Windows, <span class="kbd">⌥</span><span class="kbd">⌘</span><span class="kbd">8</span> on macOS.</span></li>
        <li class="flex gap-3"><span class="num text-stone-500 w-4 shrink-0">3</span><span>Paste it here and drag a box around <strong class="text-stone-200">only the item slots</strong>.</span></li>
      </ol>
      <p class="text-stone-500 text-xs mt-3">Any zoom works: the slots are found automatically. Amounts outlined in yellow could not be read clearly, so check them.</p>
    </details>
  </div>

  <div class="card p-6 flex flex-col" data-rise style="--d:1">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <label for="server-select" class="label block mb-1.5">Your world</label>
        <select id="server-select" class="field">
          <option value="">Select a world</option>
          <% @servers.each do |s| %>
            <option value="<%= s %>"><%= s %></option>
          <% end %>
        </select>
      </div>
      <label class="flex items-end gap-2.5 text-[13.5px] text-stone-300 cursor-pointer select-none pb-2.5">
        <input id="sorted-by-name" type="checkbox" checked class="accent-amber-400 w-4 h-4 mb-0.5">
        <span>Stash sorted by <strong class="text-stone-100">Name (A–Z)</strong><span class="block text-xs text-stone-500">tells look-alike items apart</span></span>
      </label>
    </div>

    <label id="drop-zone" for="file-input"
           class="flex-1 min-h-[180px] flex flex-col items-center justify-center rounded-xl border border-dashed border-white/15 bg-stone-950/50 p-6 text-center cursor-pointer hover:border-amber-400/60 hover:bg-stone-950 transition-colors">
      <svg class="text-stone-500 mb-3" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.8"/><path d="m21 16-5-5-9 9"/></svg>
      <p class="text-[15px] font-medium">Paste a screenshot <span class="kbd ml-1">⌘V</span></p>
      <p class="text-stone-500 text-[13px] mt-1">or drop it here, or click to choose a file</p>
      <p class="text-stone-600 text-xs mt-3">A PNG screenshot reads better than a phone photo or an image sent through WhatsApp.</p>
      <input id="file-input" type="file" accept="image/png,image/jpeg,image/webp" class="hidden">
    </label>
  </div>
</section>

<!-- Screenshot + selection -->
<section id="stage-wrap" class="reveal hidden card p-4 sm:p-5 mb-4">
  <p id="stage-hint" class="text-[13.5px] text-stone-300 mb-3">Drag a box around the items of your stash (only the item slots).</p>
  <div class="relative overflow-auto rounded-xl border border-white/10 bg-black" style="max-height:70vh">
    <canvas id="stage" class="block cursor-crosshair" style="touch-action:none"></canvas>
  </div>
  <div class="mt-4 flex flex-wrap gap-2 items-center">
    <button id="analyze-btn" disabled class="btn-primary">Analyze stash</button>
    <button id="clear-btn" class="btn btn-ghost">New screenshot</button>
    <div id="progress" class="hidden flex-1 min-w-[12rem] ml-2">
      <div class="bar"><i id="progress-bar" style="width:0; background:var(--gold); animation:none; transition:width .3s var(--ease)"></i></div>
      <p id="progress-label" class="text-xs text-stone-500 mt-1.5"></p>
    </div>
  </div>
</section>

<div id="status-bar" class="hidden text-center py-4 text-sm"></div>

<!-- Summary -->
<section id="summary-bar" class="reveal hidden grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
  <div class="card p-5">
    <p class="label">Items recognised</p>
    <p class="serif text-[40px] leading-none num mt-4" id="sum-items">—</p>
    <p class="text-xs text-stone-400 mt-2" id="sum-unsure">—</p>
  </div>
  <div class="card p-5">
    <p class="label">Sell everything to NPCs</p>
    <p class="serif text-[40px] leading-none num mt-4"><span id="sum-npc" class="text-amber-400">—</span></p>
  </div>
  <div class="card p-5 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(120% 90% at 100% 0%, rgba(95,207,146,.10), transparent 60%)"></div>
    <p class="label">Best option · Market + NPC</p>
    <p class="serif text-[40px] leading-none num mt-4"><span id="sum-best" class="text-green-400">—</span></p>
    <p id="sum-note" class="text-xs text-stone-400 mt-2"></p>
  </div>
</section>

<!-- Filter + sort -->
<div id="filter-bar" class="reveal hidden mb-3 flex flex-wrap gap-3 items-center">
  <div class="seg">
    <button class="filter-btn bg-amber-700 text-white" data-verdict="all">All</button>
    <button class="filter-btn bg-stone-800 text-stone-300" data-verdict="market">Market</button>
    <button class="filter-btn bg-stone-800 text-stone-300" data-verdict="npc">NPC</button>
  </div>
  <div class="seg">
    <button class="sort-btn bg-amber-700 text-white" data-sort="check">Check first</button>
    <button class="sort-btn bg-stone-800 text-stone-300" data-sort="high">Highest</button>
    <button class="sort-btn bg-stone-800 text-stone-300" data-sort="low">Lowest</button>
  </div>
</div>

<!-- Results -->
<section id="results-container" class="reveal hidden card overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th class="w-12"></th>
        <th>Item</th>
        <th class="text-center">Qty</th>
        <th class="text-right">NPC price</th>
        <th class="text-right">NPC total</th>
        <th class="text-right">Market price</th>
        <th class="text-right">Market total</th>
        <th class="text-center">Sell to</th>
      </tr>
    </thead>
    <tbody id="results-body" class="stagger"></tbody>
  </table>
</section>
<datalist id="item-names"></datalist>

<script src="/stash/analyzer.js"></script>
<script>
(function () {
  const MARKET_API = "/items/market_prices";
  const $ = id => document.getElementById(id);
  const serverSel = $("server-select"), stage = $("stage"), sx = stage.getContext("2d");
  const analyzeBtn = $("analyze-btn"), statusBar = $("status-bar");

  // ── helpers ────────────────────────────────────────────────────────────────
  const esc = s => s == null ? "" : String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  const gp = n => n > 0 ? '<span class="num">' + n.toLocaleString() + '</span> <span class="text-stone-500 text-xs">gp</span>' : '<span class="text-stone-600">—</span>';
  const gpBig = n => Math.round(n).toLocaleString() + '<span class="text-lg text-stone-500 font-sans"> gp</span>';
  function setStatus(msg, cls = "text-stone-300") { statusBar.className = `text-center py-4 text-sm ${cls}`; statusBar.textContent = msg; }
  function clearStatus() { statusBar.className = "hidden"; }

  // remembered server (shared with the Loot Analyzer)
  try { const w = localStorage.getItem("tibia_world"); if (w) serverSel.value = w; } catch (e) {}
  serverSel.addEventListener("change", () => { try { localStorage.setItem("tibia_world", serverSel.value); } catch (e) {} TLFUI.showWorld(); if (results) priceAll(); });

  // ── data (loaded once, cached by the browser) ──────────────────────────────
  let dataPromise = null;
  function loadData() {
    return dataPromise ||= (async () => {
      const [atlas, digits, catalog, atlasImg] = await Promise.all([
        fetch("/stash/atlas.json").then(r => r.json()),
        fetch("/stash/digits.json").then(r => r.json()),
        fetch("<%= stash_catalog_path %>").then(r => r.json()),
        StashAnalyzer.loadImage("/stash/atlas.png"),
      ]);
      const names = {}; for (const [id, it] of Object.entries(catalog)) names[id] = it.n;
      const index = {}; atlas.ids.forEach((id, i) => { if (!(id in index)) index[id] = i; });   // first cell: the single item
      const byName = {}; for (const [id, it] of Object.entries(catalog)) byName[it.n.toLowerCase()] = +id;
      $("item-names").innerHTML = Object.values(catalog).map(it => `<option value="${esc(it.n)}">`).join("");
      return { atlas, digits, catalog, atlasImg, names, index, byName };
    })();
  }

  // ── screenshot in, selection ──────────────────────────────────────────────
  let shot = null, scale = 1, sel = null, drag = null, results = null;
  async function useFile(file) {
    if (!file || !/^image\//.test(file.type)) return setStatus("That is not an image.", "text-[#f0524f]");
    if (file.size > 25 * 1024 * 1024) return setStatus("Image too large (max 25 MB).", "text-[#f0524f]");
    const url = URL.createObjectURL(file);
    try { shot = await StashAnalyzer.loadImage(url); } catch (e) { return setStatus("Could not read that image.", "text-[#f0524f]"); }
    finally { URL.revokeObjectURL(url); }
    sel = null; results = null;
    $("stage-wrap").classList.remove("hidden");
    ["summary-bar", "filter-bar", "results-container"].forEach(id => $(id).classList.add("hidden"));
    clearStatus();
    const maxW = $("stage-wrap").clientWidth || 900;
    scale = Math.min(1, maxW / shot.width);
    stage.width = Math.round(shot.width * scale); stage.height = Math.round(shot.height * scale);
    draw();
    analyzeBtn.disabled = true;
    loadData();   // start downloading the sprites while the user selects
  }
  $("file-input").addEventListener("change", e => useFile(e.target.files[0]));
  const dz = $("drop-zone");
  dz.addEventListener("dragover", e => { e.preventDefault(); dz.classList.add("!border-amber-400"); });
  dz.addEventListener("dragleave", () => dz.classList.remove("!border-amber-400"));
  dz.addEventListener("drop", e => { e.preventDefault(); dz.classList.remove("!border-amber-400"); useFile(e.dataTransfer.files[0]); });
  document.addEventListener("paste", e => {
    const f = [...(e.clipboardData?.files || [])].find(f => f.type.startsWith("image/"));
    if (f) { e.preventDefault(); useFile(f); }
  });
  $("clear-btn").addEventListener("click", () => {
    shot = null; sel = null; results = null; $("file-input").value = "";
    ["stage-wrap", "summary-bar", "filter-bar", "results-container"].forEach(id => $(id).classList.add("hidden"));
    clearStatus();
  });

  function draw(highlight) {
    if (!shot) return;
    sx.imageSmoothingEnabled = true;
    sx.drawImage(shot, 0, 0, stage.width, stage.height);
    if (sel) {
      sx.strokeStyle = "#e3b04a"; sx.lineWidth = 2; sx.setLineDash(results ? [] : [6, 4]);
      sx.strokeRect(sel.x * scale, sel.y * scale, sel.w * scale, sel.h * scale); sx.setLineDash([]);
    }
    if (results) results.slots.forEach((s, i) => {
      const [x0, y0, x1, y1] = s.box;
      sx.strokeStyle = i === highlight ? "#ffffff" : (s.edited || s.confident ? "#5fcf92" : "#e3b04a");
      sx.lineWidth = i === highlight ? 3 : 1.5;
      sx.strokeRect((sel.x + x0 + 1) * scale, (sel.y + y0 + 1) * scale, (x1 - x0 - 2) * scale, (y1 - y0 - 2) * scale);
    });
  }
  const pos = e => { const r = stage.getBoundingClientRect(); return { x: (e.clientX - r.left) / scale, y: (e.clientY - r.top) / scale }; };
  stage.addEventListener("pointerdown", e => {
    if (!shot) return;
    if (results) {   // click on a slot: jump to its row
      const p = pos(e), i = results.slots.findIndex(s => p.x >= sel.x + s.box[0] && p.x < sel.x + s.box[2] && p.y >= sel.y + s.box[1] && p.y < sel.y + s.box[3]);
      if (i >= 0) { focusRow(i); return; }
    }
    drag = pos(e); stage.setPointerCapture(e.pointerId);
  });
  stage.addEventListener("pointermove", e => {
    if (!drag) return;
    const p = pos(e);
    sel = { x: Math.min(drag.x, p.x), y: Math.min(drag.y, p.y), w: Math.abs(p.x - drag.x), h: Math.abs(p.y - drag.y) };
    results = null; draw();
  });
  stage.addEventListener("pointerup", () => {
    drag = null;
    analyzeBtn.disabled = !(sel && sel.w > 40 && sel.h > 25);
  });

  // ── analysis ───────────────────────────────────────────────────────────────
  analyzeBtn.addEventListener("click", async () => {
    if (!sel) return;
    analyzeBtn.disabled = true; clearStatus();
    $("progress").classList.remove("hidden");
    const progress = (f, label) => { $("progress-bar").style.width = Math.round(f * 100) + "%"; $("progress-label").textContent = label; };
    try {
      progress(0.02, "Loading item sprites…");
      const data = await loadData();
      const area = document.createElement("canvas");
      area.width = Math.round(sel.w); area.height = Math.round(sel.h);
      area.getContext("2d", { willReadFrequently: true }).drawImage(shot, sel.x, sel.y, sel.w, sel.h, 0, 0, area.width, area.height);
      results = await StashAnalyzer.analyze(area, data, { sortedByName: $("sorted-by-name").checked }, progress);
      results.data = data;
      if (!results.slots.length) throw new Error("No items found in the selected area.");
      draw(); renderTable(); priceAll();
    } catch (e) {
      setStatus(e.message, "text-[#f0524f]");
    } finally {
      analyzeBtn.disabled = false;
      setTimeout(() => $("progress").classList.add("hidden"), 800);
    }
  });

  // ── results table ──────────────────────────────────────────────────────────
  const market = {};   // market_item_id -> price (what buyers pay)
  function spriteStyle(id) {
    const i = results.data.index[id]; if (i == null) return "";
    const c = results.data.atlas.cols;
    return `background:url(/stash/atlas.png) -${(i % c) * 32}px -${Math.floor(i / c) * 32}px;width:32px;height:32px;image-rendering:pixelated`;
  }
  function rowHtml(s, i) {
    const it = results.data.catalog[s.itemId] || {};
    const alts = s.confident || s.edited ? "" :
      `<div class="mt-1 flex flex-wrap gap-1">${s.alternatives.map(a => `<button type="button" data-alt="${a}" class="text-[11px] h-6 px-2 rounded-md border border-white/10 text-stone-300 hover:text-white hover:border-white/25 transition-colors">${esc(results.data.catalog[a]?.n)}</button>`).join("")}</div>`;
    return `
      <td><div class="w-9 h-9 rounded-lg bg-stone-900 border border-white/5 grid place-items-center"><div style="${spriteStyle(s.itemId)}"></div></div></td>
      <td>
        <div class="flex items-center gap-2">
          ${s.confident || s.edited ? "" : '<span title="Not sure — check this one" class="text-amber-400 text-[13px]">⚠️</span>'}
          <input data-name list="item-names" value="${esc(it.n)}" class="bg-transparent border-b border-transparent hover:border-white/20 focus:border-amber-400 focus:outline-none text-stone-100 font-medium w-full min-w-[10rem] py-0.5 transition-colors">
        </div>${alts}
      </td>
      <td class="text-center"><input data-qty type="number" min="0" value="${s.count ?? 1}" title="${s.countSure || s.edited ? '' : 'Could not read this number clearly — please check'}" class="num w-20 h-8 bg-stone-950 border rounded-lg px-2 text-center text-stone-100 focus:outline-none focus:!border-amber-400 ${s.countSure || s.edited ? '!border-white/10' : '!border-amber-400'}"></td>
      <td class="text-right" data-npc></td>
      <td class="text-right" data-npc-total></td>
      <td class="text-right text-sky-400" data-mkt></td>
      <td class="text-right text-sky-300" data-mkt-total></td>
      <td class="text-center" data-verdict></td>`;
  }
  let rows = [];                                  // slot index -> <tr>
  let currentVerdict = "all", currentSort = "check";
  function renderTable() {
    rows = results.slots.map((s, i) => {
      const tr = document.createElement("tr");
      tr.dataset.i = i; tr.className = "";
      tr.innerHTML = rowHtml(s, i);
      return tr;
    });
    ["results-container", "summary-bar", "filter-bar"].forEach(id => $(id).classList.remove("hidden"));
    recalc(); applyView();
  }
  // Filter by where to sell, then sort: "check first" puts the rows to check (unsure item or
  // hard-to-read quantity) on top, the rest in stash order; highest / lowest by best total.
  // Rows only move here (buttons, new prices), not while a quantity is being edited.
  function applyView() {
    const body = $("results-body"), check = s => !s.edited && (!s.confident || !s.countSure);
    const best = i => parseFloat(rows[i].dataset.best) || 0;
    const order = rows.map((_, i) => i).filter(i => currentVerdict === "all" || rows[i].dataset.verdict === currentVerdict);
    if (currentSort === "check") order.sort((a, b) => check(results.slots[b]) - check(results.slots[a]) || a - b);
    else order.sort((a, b) => (currentSort === "high" ? best(b) - best(a) : best(a) - best(b)) || a - b);
    const out = [];
    let header = null;
    order.forEach(i => {
      const kind = check(results.slots[i]) ? "check" : "ok";
      if (currentSort === "check" && kind !== header) {
        header = kind;
        const h = document.createElement("tr");
        h.innerHTML = `<td colspan="8" class="!py-2.5 text-xs font-medium ${kind === "check" ? "text-amber-300 bg-amber-400/[.06]" : "text-stone-500 bg-white/[.02]"}">${kind === "check" ? "Check these first: fix the item or the quantity if needed" : "Recognised"}</td>`;
        out.push(h);
      }
      out.push(rows[i]);
    });
    if (!order.length) {
      const h = document.createElement("tr");
      h.innerHTML = '<td colspan="8" class="!py-8 text-center text-stone-500">No items here.</td>';
      out.push(h);
    }
    body.replaceChildren(...out);
  }
  function pick(cls, btn) {
    document.querySelectorAll(cls).forEach(b => {
      const on = b === btn;
      b.classList.toggle("bg-amber-700", on); b.classList.toggle("text-white", on);
      b.classList.toggle("bg-stone-800", !on); b.classList.toggle("text-stone-300", !on); b.classList.toggle("hover:bg-stone-700", !on);
    });
  }
  document.querySelectorAll(".filter-btn").forEach(btn => btn.addEventListener("click", () => {
    pick(".filter-btn", btn); currentVerdict = btn.dataset.verdict; if (results) applyView();
  }));
  document.querySelectorAll(".sort-btn").forEach(btn => btn.addEventListener("click", () => {
    pick(".sort-btn", btn); currentSort = btn.dataset.sort; if (results) applyView();
  }));
  function rerenderRow(i) {
    rows[i].innerHTML = rowHtml(results.slots[i], i); recalc(); draw();
  }
  function focusRow(i) {
    const tr = rows[i];
    if (!tr || !tr.isConnected) return;
    tr.scrollIntoView({ behavior: "smooth", block: "center" });
    tr.classList.add("bg-amber-400/10"); setTimeout(() => tr.classList.remove("bg-amber-400/10"), 1200);
    draw(i);
  }
  $("results-body").addEventListener("click", e => {
    const b = e.target.closest("[data-alt]"); if (!b) return;
    const i = +b.closest("tr").dataset.i, s = results.slots[i];
    s.alternatives = [s.itemId, ...s.alternatives.filter(a => a !== +b.dataset.alt)];
    s.itemId = +b.dataset.alt; s.edited = true; rerenderRow(i); priceAll();
  });
  $("results-body").addEventListener("change", e => {
    const tr = e.target.closest("tr"); if (!tr) return;
    const i = +tr.dataset.i, s = results.slots[i];
    if (e.target.matches("[data-qty]")) { s.count = Math.max(0, parseInt(e.target.value, 10) || 0); s.countSure = true; e.target.classList.replace("!border-amber-400", "!border-white/10"); recalc(); }
    if (e.target.matches("[data-name]")) {
      const id = results.data.byName[e.target.value.trim().toLowerCase()];
      if (id) { s.itemId = id; s.edited = true; rerenderRow(i); priceAll(); }
      else e.target.classList.add("text-[#f0524f]");
    }
  });
  $("results-body").addEventListener("mouseover", e => { const tr = e.target.closest("tr"); if (tr) draw(+tr.dataset.i); });

  function recalc() {
    let npcSum = 0, bestSum = 0, unsure = 0, missing = 0, biggestUnsure = null;
    results.slots.forEach((s, i) => {
      const tr = rows[i], it = results.data.catalog[s.itemId] || {};
      const qty = s.count ?? 1, npc = it.npc || 0, mPrice = market[it.m] ?? null;
      const npcTotal = npc * qty, mTotal = mPrice > 0 ? mPrice * qty : 0;
      tr.querySelector("[data-npc]").innerHTML = gp(npc);
      tr.querySelector("[data-npc-total]").innerHTML = gp(npcTotal);
      tr.querySelector("[data-mkt]").innerHTML = mPrice == null ? '<span class="skeleton inline-block w-14 h-4 align-middle">&nbsp;</span>' : gp(mPrice);
      tr.querySelector("[data-mkt-total]").innerHTML = gp(mTotal);
      const v = tr.querySelector("[data-verdict]");
      if (mTotal > npcTotal) v.innerHTML = '<span class="verdict market">Market</span>';
      else if (npcTotal > 0) v.innerHTML = `<span class="verdict npc">NPC</span><div class="text-stone-500 text-xs mt-1">${esc(it.by || "")}</div>`;
      else v.innerHTML = '<span class="text-stone-600">—</span>';
      npcSum += npcTotal; bestSum += Math.max(npcTotal, mTotal);
      const best = Math.max(npcTotal, mTotal);
      tr.dataset.best = best;
      tr.dataset.verdict = mTotal > npcTotal ? "market" : npcTotal > 0 ? "npc" : "none";
      if (!s.countSure && (!biggestUnsure || best > biggestUnsure.v)) biggestUnsure = { v: best, name: it.n, qty };
      if (!s.confident && !s.edited) unsure++;
      if (!s.countSure) missing++;
    });
    TLFUI.count($("sum-items"), results.slots.length);
    $("sum-unsure").innerHTML = unsure ? `<span class="text-amber-300">${unsure} to check</span>, marked ⚠️ below` : "All items look right";
    TLFUI.count($("sum-npc"), npcSum, gpBig);
    TLFUI.count($("sum-best"), bestSum, gpBig);
    // one hard-to-read quantity making up a big share of the total is most likely a misread
    const dominant = biggestUnsure && bestSum > 0 && biggestUnsure.v / bestSum > 0.3
      ? ` ${biggestUnsure.qty.toLocaleString()}× ${biggestUnsure.name} is ${Math.round(biggestUnsure.v / bestSum * 100)}% of the total: make sure that quantity is right.` : "";
    $("sum-note").textContent = (!serverSel.value ? "Select your server to include Market prices." :
      (missing ? `${missing} quantities were hard to read — check the ones outlined in yellow.` : "")) + dominant;
  }

  async function priceAll() {
    if (!results || !serverSel.value) { if (results) recalc(); return; }
    const ids = [...new Set(results.slots.map(s => results.data.catalog[s.itemId]?.m).filter(Boolean))].filter(m => !(m in market));
    if (ids.length) {
      try {
        const r = await fetch(`${MARKET_API}?server=${encodeURIComponent(serverSel.value)}&item_ids=${ids.join(",")}`);
        const list = await r.json();
        if (!Array.isArray(list) || !list.length) throw new Error("no data");
        list.forEach(m => { market[m.id] = m.buy_offer > 0 ? m.buy_offer : (m.month_average_buy || 0); });
        ids.forEach(m => { if (!(m in market)) market[m] = 0; });
      } catch (e) { setStatus("Market prices are unavailable right now, so NPC prices are shown. Try again in a minute.", "text-amber-400"); }
    }
    recalc();
    if (ids.length) applyView();   // new prices: re-sort (fixing a row alone does not move it)
  }
})();
</script>
